{{ 'section-latest-features.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_blog = blogs[section.settings.blog]
  assign tabs_list = section.blocks | map: 'settings' | map: 'city_name' | uniq
  assign max_articles = section.settings.max_articles | default: 5
  assign today = 'now' | date: '%Y-%m-%d'
-%}
<div class="latest-features-section" id="events-section">
  <div class="header-row">
    <div class="title-column" style="max-width: {{ section.settings.main_title_width }}px;">
      <h2 class="main-title h1 heading" style="text-align: {{ section.settings.main_title_align }}">
        {{ section.settings.main_title }}
      </h2>
      <h2 class="sub-title h1 heading" style="text-align: {{ section.settings.sub_title_align }}">
        {{ section.settings.sub_title }}
      </h2>
    </div>
    <div class="arrow-label">
      {{ section.settings.section_aside_image | image_url: width: 500 | image_tag }}
    </div>
  </div>

  <div class="tab-groups-container">
    <div class="tab-images-column">
      {%- if selected_blog -%}
        {%- assign image_index = 0 -%}
        {%- for city in tabs_list -%}
          {%- comment -%} Build this city's tag lookup once, not once per article {%- endcomment -%}
          {%- liquid
            assign city_tag_list = ''
            for block in section.blocks
              if block.settings.city_name == city
                assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#'
                assign city_tag_list = city_tag_list | append: '|' | append: normalized_city_tag | append: '|'
              endif
            endfor
            assign city_image_count = 0
          -%}
          {%- for article in selected_blog.articles -%}
            {%- if city_image_count >= max_articles -%}
              {%- break -%}
            {%- endif -%}
            {%- liquid
              assign article_matches_city = false
              assign is_future_event = false
              assign has_date_tag = false

              for tag in article.tags
                if tag contains 'event-date::'
                  assign has_date_tag = true
                  assign event_date = tag | remove: 'event-date::' | date: '%Y-%m-%d'
                  if event_date >= today
                    assign is_future_event = true
                  endif
                  break
                endif
              endfor

              unless has_date_tag
                assign is_future_event = true
              endunless

              if is_future_event
                for tag in article.tags
                  assign padded_tag = tag | downcase | remove: '#' | prepend: '|' | append: '|'
                  if city_tag_list contains padded_tag
                    assign article_matches_city = true
                    break
                  endif
                endfor
              endif
            -%}
            {%- if article_matches_city and is_future_event -%}
              <div
                class="tab-image-item {% if image_index == 0 %}active{% endif %}"
                data-tab-id="article-{{ article.id }}"
                data-tab-image-index="{{ image_index }}"
                data-tab-group-title="{{ city }}"
              >
                <img
                  src="{{ article.image | image_url: width: 1920 }}"
                  alt="{{ article.title }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              </div>
              {%- liquid
                assign image_index = image_index | plus: 1
                assign city_image_count = city_image_count | plus: 1
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="tab-list-navs" data-tabs-hidden="{{ section.settings.show_tab_list }}">
      {%- if section.settings.show_tab_list -%}
        <div class="tabs-panel">
          {%- for tab in tabs_list -%}
            <button class="tab-list-nav-item {% if forloop.first %}active{% endif %}" data-tab-group-title="{{ tab }}">
              <span class="tab-list-nav-item-title">{{ tab }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="tab-list-item-contents">
        {%- if selected_blog -%}
          {%- assign first_city = tabs_list.first -%}
          {%- for city in tabs_list -%}
            {%- comment -%} Build this city's tag lookup once, not once per article {%- endcomment -%}
            {%- liquid
              assign city_tag_list = ''
              for block in section.blocks
                if block.settings.city_name == city
                  assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#'
                  assign city_tag_list = city_tag_list | append: '|' | append: normalized_city_tag | append: '|'
                endif
              endfor
              assign city_article_count = 0
              assign city_total_articles = 0
            -%}

            {%- comment -%} Single pass: render up to max_articles, keep counting for the View More button {%- endcomment -%}
            {%- for article in selected_blog.articles -%}
              {%- liquid
                assign article_matches_city = false
                assign is_future_event = false
                assign has_date_tag = false
                assign event_date = ''

                for tag in article.tags
                  if tag contains 'event-date::'
                    assign has_date_tag = true
                    assign event_date = tag | remove: 'event-date::' | date: '%Y-%m-%d'
                    if event_date >= today
                      assign is_future_event = true
                    endif
                    break
                  endif
                endfor

                unless has_date_tag
                  assign is_future_event = true
                endunless

                if is_future_event
                  for tag in article.tags
                    assign padded_tag = tag | downcase | remove: '#' | prepend: '|' | append: '|'
                    if city_tag_list contains padded_tag
                      assign article_matches_city = true
                      break
                    endif
                  endfor
                endif

                if article_matches_city and is_future_event
                  assign city_total_articles = city_total_articles | plus: 1
                endif
              -%}
              {%- if article_matches_city and is_future_event and city_article_count < max_articles -%}
                {%- assign city_article_count = city_article_count | plus: 1 -%}
                <div
                  class="tab-list-item-container {% if city == first_city %}active{% endif %} {% if city_article_count == 1 %}expanded{% endif %}"
                  data-tab-group-title="{{ city }}"
                  data-tab-id="article-{{ article.id }}"
                  data-article-url="{{ article.url }}"
                >
                  <div class="tab-list-item-header">
                    <p class="tab-list-item-index">/{{ city_article_count | prepend: '0' | slice: -2, 2 }}</p>
                    <div class="tab-list-item-content-container">
                      <div class="tab-list-item-content">
                        <span class="tab-list-item-title font-zen">{{ article.title }}</span>
                        <div class="tab-list-item-content-inner">
                          <span class="tab-list-item-subtitle">
                            {{- article.excerpt_or_content | strip_html | truncatewords: 15 -}}
                          </span>
                          <span class="tab-list-item-date-mobile-only">{{ event_date | date: '%m.%d.%Y' }}</span>
                          <a
                            class="tab-list-item-button"
                            href="{{ article.url }}"
                          >
                            <span> {{ section.settings.event_cta_label | default: 'Register Now' }} </span>
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="20"
                              height="20"
                              viewBox="0 0 20 20"
                              fill="none"
                            >
                              <path d="M7.91675 5L12.9167 10L7.91675 15" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </a>
                        </div>
                      </div>
                    </div>
                    <span class="tab-list-item-date">{{ event_date | date: '%m.%d.%Y' }}</span>
                  </div>
                  <div class="tab-list-item-mobile-image">
                    <img
                      src="{{ article.image | image_url: width: 1920 }}"
                      alt="{{ article.title }}"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      loading="lazy"
                    >
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} Add View More button if there are more articles than the limit {%- endcomment -%}
            {%- if city_total_articles > max_articles -%}
              <div
                class="tab-list-item-container view-more-container {% if city == first_city %}active{% endif %}"
                data-tab-group-title="{{ city }}"
              >
                <div class="view-more-container">
                  <div class="tab-cta-container">
                    {%- liquid
                      assign view_more_url = selected_blog.url
                      if city == 'Events'
                        assign view_more_url = pages['attend-an-event'].url
                      endif
                    -%}
                    <a href="{{ view_more_url }}" class="button button--solid button--with-icon">
                      <span class="view-more-text">{{ section.settings.view_more_label | default: 'View More' }}</span>
                      <span class="icon" aria-hidden="true">{%- render 'theme-symbols', icon: 'arrow-right' -%}</span>
                    </a>
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- comment -%} Show "No events found" if no articles matched this city {%- endcomment -%}
            {%- if city_article_count == 0 -%}
              <div
                class="tab-list-item-container no-events {% if city == first_city %}active{% endif %}"
                data-tab-group-title="{{ city }}"
              >
                <div class="tab-list-item-header">
                  <p class="tab-list-item-index">/00</p>
                  <div class="tab-list-item-content-container">
                    <div class="tab-list-item-content">
                      <span class="tab-list-item-title font-zen">No events found</span>
                      <div class="tab-list-item-content-inner">
                        <span class="tab-list-item-subtitle"
                          >There are currently no events scheduled for {{ city }}.</span
                        >
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'component-latest-features.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Latest Features & Events",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog",
      "info": "Choose the blog containing event articles"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title"
    },
    {
      "type": "text",
      "id": "main_title_width",
      "label": "Main Title Width",
      "default": "732"
    },
    {
      "type": "select",
      "id": "main_title_align",
      "label": "Main Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title"
    },
    {
      "type": "select",
      "id": "sub_title_align",
      "label": "Sub Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "section_aside_image",
      "label": "Section Aside Image"
    },
    {
      "type": "checkbox",
      "id": "show_tab_list",
      "label": "Show Tab List",
      "default": true
    },
    {
      "type": "number",
      "id": "max_articles",
      "label": "Maximum Articles/Events",
      "default": 5,
      "info": "Maximum number of articles/events to show per city tab"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "View More Button Label",
      "default": "View More",
      "info": "Label text for the view more button"
    },
    {
      "type": "text",
      "id": "event_cta_label",
      "label": "Event CTA Label",
      "default": "Register Now",
      "info": "Label text for event buttons"
    }
  ],
  "blocks": [
    {
      "type": "city_block",
      "name": "City Tab",
      "settings": [
        {
          "type": "text",
          "id": "city_name",
          "label": "City Name",
          "info": "This will create a tab for this city"
        },
        {
          "type": "text",
          "id": "city_tag",
          "label": "City Tag",
          "info": "The tag used in blog articles to identify events for this city (e.g., 'MIAMI', 'NEW-YORK')"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Latest Features & Events",
      "category": "Custom"
    }
  ]
}
{% endschema %}
