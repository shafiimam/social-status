{{ 'section-floating-testimonials.css' | asset_url | stylesheet_tag }}
{% capture testimonial_content %}
  {% for block in section.blocks %}
    <div class="floating-testimonials-section__testimonial" {{ block.shopify_attributes }}>
      <div class="floating-testimonials-section__testimonial-header">
        {% if block.settings.avatar != blank %}
          <img
            src="{{ block.settings.avatar | image_url: width: 100, height: 100 }}"
            alt="{{ block.settings.name }}"
            class="w-10 h-10 rounded-full object-cover"
            width="50"
            height="50"
          >
        {% endif %}
        <span class="">{{ block.settings.name }}</span>  
      </div>
      <p class="">{{ block.settings.quote }}</p>
    </div>
  {% endfor %}
{% endcapture %}

{%- comment -%}
  The marquee translates by exactly -50%, so each half of the track must be at
  least as wide as the viewport or a gap opens at the trailing edge. Card width
  is 420px + 24px margin. With six testimonials one pass is already ~2664px and
  reps stays 1, but if the client trims the list to two or three this keeps the
  row full instead of silently breaking.
{%- endcomment -%}
{%- liquid
  assign card_width = 444
  assign block_count = section.blocks.size
  if block_count < 1
    assign block_count = 1
  endif
  assign pass_width = block_count | times: card_width
  assign reps = 2560 | divided_by: pass_width | plus: 1
-%}
{%- capture testimonial_set -%}
  {%- for i in (1..reps) -%}{{ testimonial_content }}{%- endfor -%}
{%- endcapture -%}

<section
  class="floating-testimonials-section{% if section.settings.seam_fade %} floating-testimonials-section--seam-fade{% endif %}"
  style="--ft-cycle: {{ section.settings.cycle_seconds | default: 70 }}s;"
>
  <div class="floating-testimonials-section__inner">
    <div class="floating-testimonials-section__header">
      <h2 class="h1 heading text-center">{{ section.settings.section_title }}</h2>
    </div>

    <div class="floating-testimonials-section__testimonial-container">
      <div class="floating-testimonials-section__right-overlay"></div>
      <div class="floating-testimonials-section__left-overlay"></div>

      {%- comment -%}
        Each row is a CSS marquee, not a slider. The track holds the same set twice and
        translates from 0 to -50%, so the frame it resets to is identical to the frame it
        started from and the loop is invisible. The second set is decorative duplication,
        so it carries aria-hidden to keep screen readers from reading every quote twice.
      {%- endcomment -%}

      <div class="floating-testimonials-section__row">
        <div class="floating-testimonials-section__testimonial-track">
          <div class="floating-testimonials-section__set">{{ testimonial_set }}</div>
          <div class="floating-testimonials-section__set" aria-hidden="true">{{ testimonial_set }}</div>
        </div>
      </div>

      <div class="floating-testimonials-section__row">
        <div class="floating-testimonials-section__testimonial-track floating-testimonials-section__testimonial-track--reverse">
          <div class="floating-testimonials-section__set">{{ testimonial_set }}</div>
          <div class="floating-testimonials-section__set" aria-hidden="true">{{ testimonial_set }}</div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Floating Testimonials",
  "settings": [
    {
      "type": "range",
      "id": "cycle_seconds",
      "label": "Seconds per full loop",
      "info": "Higher is slower. A card returns to the same spot once per loop.",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "s",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "seam_fade",
      "label": "Fade at the loop point",
      "info": "Dims the row as the loop closes and lifts it as it reopens.",
      "default": true
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Testimonials"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Floating Testimonials",
      "category": "Custom"
    }
  ]
}
{% endschema %}
