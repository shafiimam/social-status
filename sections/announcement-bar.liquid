{%- liquid

  if section.settings.visibility == 'all'
    assign show_on_homepage = true
    assign show_on_pages = true
  elsif section.settings.visibility == 'homepage'
    assign show_on_homepage = true
  elsif section.settings.visibility == 'no-homepage'
    assign show_on_homepage = false
    assign show_on_pages = true
  elsif section.settings.visibility == 'product'
    assign show_on_product = true
  endif

  if show_on_product == true and template contains 'product'
    assign show = true
  endif
  if show_on_homepage == true and template == 'index'
    assign show = true
  endif
  if show_on_pages == true and template != 'index'
    assign show = true
  endif

-%}

{%- if show -%}

  {{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'section-announcement-bar.js' | asset_url }}" defer></script>

  <announcement-bar
    style="display:block; --announcement-font-size-mobile: {{ section.settings.mobile_font_size }}px; --announcement-font-size-desktop: {{ section.settings.desktop_font_size }}px; --announcement-marquee-gap-mobile: {{ section.settings.marquee_gap_mobile }}px; --announcement-marquee-gap-desktop: {{ section.settings.marquee_gap_desktop }}px;"
    data-js-inert
    data-display-style="{{ section.settings.display_style }}"
    id="announcement-{{ section.id }}"
  >

    <div class="announcement-bar">
      
      {%- if section.settings.display_style == 'marquee' -%}
        <div
          class="announcement-bar__marquee"
          data-marquee
          data-speed="{{ section.settings.marquee_speed }}"
          data-direction="{{ section.settings.marquee_direction }}"
          {% if section.settings.marquee_pause_on_hover %}data-pause-on-hover{% endif %}
        >
          <div class="announcement-bar__marquee-track" data-marquee-track>
            <div class="announcement-bar__marquee-group" data-marquee-group>
              {%- for block in section.blocks -%}
                <span class="announcement announcement--marquee" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" {% if block.settings.target %}target="_blank" rel="noopener"{% endif %}>
                  {%- endif -%}
                    {{ block.settings.text | escape }}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                </span>
                {%- if section.settings.marquee_separator != blank -%}
                  <span class="announcement-bar__marquee-separator" aria-hidden="true">{{ section.settings.marquee_separator | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="announcement-bar__content">
          {%- if section.blocks.size > 1 -%}
            <button class="announcement-bar__content-nav announcement-bar__content-nav--left announcement-bar__content-nav--disabled">
              <span class="visually-hidden">{{ 'general.accessibility_labels.previous' | t }}</span>
              {%- render 'theme-symbols', icon: 'arrow_icon_down_slim' -%}
            </button>
          {%- endif -%}

          <div class="announcement-bar__slider" data-js-slider>
            {%- for block in section.blocks -%}
              <span class="announcement" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" {% if block.settings.target %}target="_blank" rel="noopener"{% endif %}>
                {%- endif -%}
                  {{ block.settings.text | escape }}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </span>
            {%- endfor -%}
          </div>

          {%- if section.blocks.size > 1 -%}
            <button class="announcement-bar__content-nav announcement-bar__content-nav--right">
              <span class="visually-hidden">{{ 'general.accessibility_labels.next' | t }}</span>
              {%- render 'theme-symbols', icon: 'arrow_icon_down_slim' -%}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

  </announcement-bar>

  <script>window.fixVhByVars();</script>

  {% style %}
    {%- if section.settings.bar_txtcolor != 'rgba(0,0,0,0)' -%}
      #announcement-{{ section.id }} .announcement-bar, #announcement-{{ section.id }} .announcement-bar a, #announcement-{{ section.id }} .announcement-bar .localization-form__item-text {
        color: {{ section.settings.bar_txtcolor }};
      }
      #announcement-{{ section.id }} .announcement-bar svg *{
        fill: {{ section.settings.bar_txtcolor }} !important;
      }
    {%- endif -%}
    {%- if section.settings.bar_bgcolor != 'rgba(0,0,0,0)' -%}
      #announcement-{{ section.id }}, #announcement-{{ section.id }} .announcement-bar__content-nav {
        background: {{ section.settings.bar_bgcolor }};
      }
    {%- endif -%}
    {%- if section.settings.bar_bordercolor != 'rgba(0,0,0,0)' -%}
      #announcement-{{ section.id }}{
        border-bottom: solid 1px {{ section.settings.bar_bordercolor }};
      }
    {%- endif -%}
  {% endstyle %}

{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "mount-announcement-bar",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "t:sections.refactor_words.announcement-bar.visibility.label",
      "options": [
        {
          "value": "all",
          "label": "t:sections.refactor_words.announcement-bar.visibility.option_1"
        },
        {
          "value": "homepage",
          "label": "t:sections.refactor_words.announcement-bar.visibility.option_2"
        },
        {
          "value": "product",
          "label": "t:sections.refactor_words.announcement-bar.visibility.option_4"
        },
        {
          "value": "no-homepage",
          "label": "t:sections.refactor_words.announcement-bar.visibility.option_3"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:settings_schema.colors.name"
    },
    {
      "type": "color",
      "id": "bar_txtcolor",
      "label": "t:sections.announcement-bar.settings.bar_txtcolor.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bar_bgcolor",
      "label": "t:sections.announcement-bar.settings.bar_bgcolor.label",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bar_bordercolor",
      "label": "t:sections.refactor_words.announcement-bar.color.border",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ],
      "default": "marquee"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 9,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Desktop text size",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 9,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Mobile text size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Marquee settings",
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "Speed",
      "default": 0.3,
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "To left"
        },
        {
          "value": "right",
          "label": "To right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "marquee_pause_on_hover",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "text",
      "id": "marquee_separator",
      "label": "Separator",
      "info": "Leave blank to hide the separator.",
      "default": "•",
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_gap_mobile",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 20,
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_gap_desktop",
      "min": 10,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 40,
      "visible_if": "{{ section.settings.display_style == 'marquee' }}"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "t:sections.local-extra-words.sections.announcement-bar.blocks.content.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.local-extra-words.sections.announcement-bar.blocks.content.settings.text",
          "default": "Write an important announcement here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.local-extra-words.sections.announcement-bar.blocks.content.settings.link"
        },
        {
          "type": "checkbox",
          "id": "target",
          "visible_if": "{{ block.settings.link != blank }}",
          "label": "t:sections.local-extra-words.sections.announcement-bar.blocks.content.settings.target",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name",
      "blocks": [
        {
          "type": "content"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
