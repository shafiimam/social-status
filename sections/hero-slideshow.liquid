<script>
  document.addEventListener('DOMContentLoaded', function () {
    const heroSlideshow = document.querySelector('.hero-slideshow');
    const siteHeader = document.getElementById('site-header');

    if (!heroSlideshow || !siteHeader) return;

    // Create intersection observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Slideshow is in view - add transparent-header class
            siteHeader.classList.add('transparent-header');
          } else {
            // Slideshow is out of view - remove transparent-header class
            siteHeader.classList.remove('transparent-header');
          }
        });
      },
      {
        // Trigger when any part of the slideshow is visible
        threshold: 0,
        // Add some margin to trigger slightly before/after the element
        rootMargin: '0px 0px -10px 0px',
      }
    );

    // Start observing the slideshow
    observer.observe(heroSlideshow);
  });
</script>
