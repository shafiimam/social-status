{{ 'section-blog-events.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-blog-events.js' | asset_url }}" defer></script>

{% assign now_date = 'now' | date: '%s' %}
{% assign selected_blog = blogs[section.settings.blog] %}

{%- liquid
  # theme-check-disable
  capture content_for_query_string
    echo content_for_header
  endcapture
  # theme-check-enable

  assign page_url = content_for_query_string | split: '"pageurl":"' | last | split: '"' | first | split: '.myshopify.com' | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&'

  assign page_query_string = page_url | split: '/' | last
  assign split_string = page_query_string | split: '?'
  assign parameters = split_string[1] | downcase | split: '&'

  comment
    If the URL uses comma-separated parameters (like _fd=0,pb=0,filter=charlotte),
    we need to handle both formats. Check if we have comma-separated parameters.
  endcomment

  if parameters.size == 1 and parameters[0] contains ','
    assign parameters = parameters[0] | split: ','
  endif

  assign request_filter = ''

  for parameter in parameters
    assign parameter_arr = parameter | split: '='
    assign parameter_property = parameter_arr[0] | downcase
    if parameter_property == 'filter'
      assign request_filter = parameter_arr[1]
      break
    endif
  endfor

  assign parameters = parameters | join: ','
-%}
<div class="events_page events-slider-section">
  <section id="coming_events">
    <div class="container">
      <ul id="filters">
        <li class="rank">
          <button class="button button--outline filter-dropdown-btn">
            <span class="filter-text">
              {% if request_filter.size != 0 %}
                {{ request_filter | upcase }}
              {% else %}
                ALL
              {% endif %}
            </span>
            <span class="filter-arrow" aria-hidden="true">
              {%- render 'theme-symbols', icon: 'arrow_icon_down_slim' -%}
            </span>
          </button>
          <div class="dropdown">
            <ul>
              <li class="{% if request_filter == blank %}selected{% endif %}">
                <a href="{{request.path}}#coming_events"> All </a>
              </li>
              {% for block in section.blocks %}
                {% if block.type == 'city_filter' %}
                  {% assign current_tags_lower = request_filter | upcase %}
                  {% assign btn_tag_lower = block.settings.btn_tag | downcase %}
                  <li class="{% if current_tags_lower contains btn_tag_lower %}selected{% endif %}">
                    <a href="/pages/besocial?filter={{ btn_tag_lower | replace: " ", "-" }}">
                      {{ block.settings.btn_text }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </li>
      </ul>

      <!-- Check for coming articles and display them -->
      {% assign has_coming_articles = false %}
      {% assign filtered_events_count = 0 %}

      {% for article in selected_blog.articles %}
        {% assign article_date = '' %}
        {% for tag in article.tags %}
          {% if tag contains 'event-date::' %}
            {% assign article_date = tag | remove: 'event-date::' | date: '%s' %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if article_date != '' and article_date > now_date %}
          {% assign article_matches_filter = false %}

          {% if request_filter.size == 0 %}
            {% comment %} No filter applied, show all articles {% endcomment %}
            {% assign article_matches_filter = true %}
          {% else %}
            {% comment %} Check if article has the matching city tag {% endcomment %}
            {% assign filter_tag_upper = request_filter | upcase %}
            {% for tag in article.tags %}
              {% assign tag_upper = tag | upcase %}
              {% assign tag_without_hash = tag_upper | remove: '#' %}
              {% if tag_upper == filter_tag_upper or tag_without_hash == filter_tag_upper %}
                {% assign article_matches_filter = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if article_matches_filter %}
            {% assign has_coming_articles = true %}
            {% assign filtered_events_count = filtered_events_count | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if has_coming_articles %}
        <div class="section_title">
          <h1 class="h1">{{ section.settings.events_coming }}</h1>
          <button class="button button--solid events-toggle-btn" type="button" data-toggle="events-view">
            <span class="btn-text-show">{{ section.settings.btn_coming }}</span>
            <span class="btn-text-hide" style="display: none;">
              {{- section.settings.btn_hide_coming | default: 'Hide Upcoming Events' -}}
            </span>
          </button>
        </div>

        <!-- Perspective Slider View (First 8 events) - Default -->
        <div class="events-slider-view">
          {% render 'events-slider-perspective',
            blog: selected_blog,
            now_date: now_date,
            section_id: 'blog-events-upcoming',
            auto_play: section.settings.events_auto_play,
            background_color: section.settings.events_bg_color,
            slide_overlay_color: section.settings.events_overlay_color,
            text_color: section.settings.events_text_color,
            text_color_card: section.settings.events_card_text_color,
            path_color: section.settings.events_path_color,
            text_alignment: section.settings.events_text_alignment,
            slider_height: section.settings.events_slider_height,
            slide_width: section.settings.events_slide_width,
            slide_height: section.settings.events_slide_height,
            initial_index: section.settings.events_initial_index,
            show_controls: section.settings.show_events_controls,
            filter_city: request_filter
          %}
        </div>

        <!-- Grid View (All events in 4 per row) - Hidden by default -->
        <div class="events-grid-view" style="display: none;">
          <div class="events-grid">
            {% for article in selected_blog.articles %}
              {% assign article_date = '' %}
              {% for tag in article.tags %}
                {% if tag contains 'event-date::' %}
                  {% assign article_date = tag | remove: 'event-date::' | date: '%s' %}
                  {% break %}
                {% endif %}
              {% endfor %}

              {% if article_date != '' and article_date > now_date %}
                {% assign article_matches_filter = false %}

                {% if request_filter.size == 0 %}
                  {% assign article_matches_filter = true %}
                {% else %}
                  {% assign filter_tag_upper = request_filter | upcase %}
                  {% for tag in article.tags %}
                    {% assign tag_upper = tag | upcase %}
                    {% assign tag_without_hash = tag_upper | remove: '#' %}
                    {% if tag_upper == filter_tag_upper or tag_without_hash == filter_tag_upper %}
                      {% assign article_matches_filter = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if article_matches_filter %}
                  <div class="event-grid-item">
                    {% render 'article-events-coming-item', article: article %}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

      {% else %}
        <!-- No events found message -->
        {% if request_filter %}
          <div class="no-events-found">
            <div class="no-events-content">
              <h2 class="no-events-title">No Events Found</h2>
              <p class="no-events-message">
                No upcoming events found for "{{ request_filter | upcase }}".
                <a href="{{request.path}}#coming_events" class="no-events-link">View all events</a> or try a different
                filter.
              </p>
            </div>
          </div>
        {% else %}
          <div class="no-events-found">
            <div class="no-events-content">
              <h2 class="no-events-title">No Upcoming Events</h2>
              <p class="no-events-message">
                There are currently no upcoming events scheduled. Check back soon for new events!
              </p>
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // URL filtering functionality
    function getUrlParameter(name) {
      name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
      var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
      var results = regex.exec(location.search);
      return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    }

    // Smooth scroll function with fallback for older browsers
    function smoothScrollToSection(element, delay = 300) {
      setTimeout(function () {
        if (element) {
          if ('scrollBehavior' in document.documentElement.style) {
            // Modern browsers with smooth scroll support
            element.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            });
          } else {
            // Fallback for older browsers
            const elementTop = element.offsetTop;
            window.scrollTo({
              top: elementTop - 20, // Small offset from top
              left: 0,
            });
          }
        }
      }, delay);
    }
    // Listen for popstate events (back/forward buttons)
    const urlFilter = getUrlParameter('filter');

    // Smooth scroll to events section when navigating with browser back/forward
    if (urlFilter) {
      const eventsSection = document.querySelector('#coming_events');
      smoothScrollToSection(eventsSection, 100);
    }
  });
</script>

{% schema %}
{
  "name": "Events Slider",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Events Blog",
      "info": "Choose the blog containing event articles"
    },
    {
      "type": "text",
      "id": "events_coming",
      "label": "Coming Events Title",
      "default": "Upcoming Events"
    },
    {
      "type": "text",
      "id": "btn_coming",
      "label": "Show All Events Button",
      "default": "Show All Events"
    },
    {
      "type": "text",
      "id": "btn_hide_coming",
      "label": "Hide Events Button",
      "default": "Hide Upcoming Events"
    },
    {
      "type": "checkbox",
      "id": "events_auto_play",
      "label": "Auto Play Slider",
      "default": false
    },
    {
      "type": "color",
      "id": "events_bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "events_overlay_color",
      "label": "Slide Overlay Color",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "color",
      "id": "events_text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "events_card_text_color",
      "label": "Card Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "events_path_color",
      "label": "Control Path Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "events_text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "events_slider_height",
      "label": "Slider Height (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "default": 350
    },
    {
      "type": "range",
      "id": "events_slide_width",
      "label": "Slide Width (px)",
      "min": 250,
      "max": 600,
      "step": 10,
      "default": 400
    },
    {
      "type": "range",
      "id": "events_slide_height",
      "label": "Slide Height (px)",
      "min": 150,
      "max": 400,
      "step": 10,
      "default": 250
    },
    {
      "type": "range",
      "id": "events_initial_index",
      "label": "Initial Slide Position",
      "min": 0,
      "max": 7,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_events_controls",
      "label": "Show Slider Controls",
      "default": true
    },
    {
      "type": "number",
      "id": "pagination_limit",
      "label": "Articles Per Page",
      "default": 1000,
      "info": "Maximum number of articles to load from the blog (higher numbers may slow down page load)"
    }
  ],
  "blocks": [
    {
      "name": "City Filter",
      "type": "city_filter",
      "settings": [
        {
          "type": "text",
          "id": "btn_text",
          "label": "Filter Button Text",
          "default": "City Name"
        },
        {
          "type": "text",
          "id": "btn_tag",
          "label": "Filter Tag",
          "default": "CITY-NAME",
          "info": "Same tag as in the blog event article. The tag must be CAPITAL. If the tag contains multiple words, use hyphens: WORD1-WORD2-WORD3."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events Slider",
      "category": "Events"
    }
  ]
}
{% endschema %}
