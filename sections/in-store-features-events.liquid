{{ 'section-latest-features.css' | asset_url | stylesheet_tag }}

{% assign tabs_list = section.blocks | map: 'settings' | map: 'tab_group_name' | uniq %}
<div class="latest-features-section">
  <div class="header-row">
    <div class="title-column" style="max-width: {{ section.settings.main_title_width }}px;">
      <h1 class="main-title h1 heading" style="text-align: {{ section.settings.main_title_align }}">
        {{ section.settings.main_title }}
      </h1>
      <h2 class="sub-title h1 heading" style="text-align: {{ section.settings.sub_title_align }}">
        {{ section.settings.sub_title }}
      </h2>
    </div>
    <div class="arrow-label">
      <span class="arrow-text-vertical font-zen" aria-hidden="true">{{ section.settings.arrow_text_1 }}</span>
      <span class="arrow-text-horizontal-1 font-zen" aria-hidden="true">{{ section.settings.arrow_text_2 }}</span>
      <span class="arrow-text-horizontal-2 font-zen" aria-hidden="true">{{ section.settings.arrow_text_2 }}</span>
    </div>
  </div>

  <div class="tab-groups-container">
    <div class="tab-images-column">
      {% assign image_index = 0 %}
      {% for tab_group in tabs_list %}
        {% for block in section.blocks %}
          {% if block.settings.tab_group_name == tab_group %}
            {% if block.type == 'blog_block' %}
              {% assign selected_blog = blogs[block.settings.blog] %}
              {% if selected_blog %}
                {% for article in selected_blog.articles %}
                  <div
                    class="tab-image-item {% if image_index == 0 %}active{% endif %}"
                    data-tab-id="blog-{{ block.id }}-{{ article.id }}"
                    data-tab-image-index="{{ image_index }}"
                    data-tab-group-title="{{ tab_group }}"
                  >
                    <img
                      src="{{ article.image | img_url: 'master' }}"
                      alt="{{ article.title }}"
                      width="100%"
                      height="100%"
                    >
                  </div>
                  {% assign image_index = image_index | plus: 1 %}
                {% endfor %}
              {% endif %}
            {% elsif block.type == 'events_block' %}
              {% assign selected_blog = blogs[block.settings.blog] %}
              {% if selected_blog %}
                {% for article in selected_blog.articles %}
                  {% assign article_matches_city = false %}
                  {% for tag in article.tags %}
                    {% assign normalized_tag = tag | downcase | remove: '#' %}
                    {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                    {% if normalized_tag == normalized_city_tag %}
                      {% assign article_matches_city = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if article_matches_city %}
                    <div
                      class="tab-image-item {% if image_index == 0 %}active{% endif %}"
                      data-tab-id="event-{{ block.id }}-{{ article.id }}"
                      data-tab-image-index="{{ image_index }}"
                      data-tab-group-title="{{ tab_group }}"
                    >
                      <img
                        src="{{ article.image | img_url: 'master' }}"
                        alt="{{ article.title }}"
                        width="100%"
                        height="100%"
                      >
                    </div>
                    {% assign image_index = image_index | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endif %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    <div class="tab-list-navs" data-tabs-hidden="{{ section.settings.show_tab_list }}">
      {% if section.settings.show_tab_list %}
        <div class="tabs-panel">
          {% for tab in tabs_list %}
            <button class="tab-list-nav-item {% if forloop.first %}active{% endif %}" data-tab-group-title="{{ tab }}">
              <span class="tab-list-nav-item-title">{{ tab }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
      <ul class="tab-list-item-contents">
        {% for tab_group in tabs_list %}
          {% assign first_tab_group = tabs_list.first %}
          {% for block in section.blocks %}
            {% if block.settings.tab_group_name == tab_group %}
              {% if block.type == 'blog_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% assign article_count = 0 %}
                  {% for article in selected_blog.articles %}
                    {% assign article_count = article_count | plus: 1 %}
                    <div
                      class="tab-list-item-container {% if tab_group == first_tab_group %}active{% endif %} {% if article_count == 1 %}expanded{% endif %}"
                      data-tab-group-title="{{ tab_group }}"
                      data-tab-id="blog-{{ block.id }}-{{ article.id }}"
                    >
                      <div class="tab-list-item-header">
                        <p class="tab-list-item-index">/{{ article_count | prepend: '0' | slice: -2, 2 }}</p>
                        <div class="tab-list-item-content-container">
                          <div class="tab-list-item-content">
                            <span class="tab-list-item-title font-zen">{{ article.title }}</span>
                            <div class="tab-list-item-content-inner">
                              <span class="tab-list-item-subtitle">{{ article.excerpt_or_content | strip_html | truncatewords: 15 }}</span>
                              <span class="tab-list-item-date-mobile-only">{{ article.created_at | date: "%d.%m" }}</span>
                              <button
                                href="{{ article.url }}"
                                class="tab-list-item-button"
                              >
                                <span> Read Article </span>
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="20"
                                  height="20"
                                  viewBox="0 0 20 20"
                                  fill="none"
                                >
                                  <path d="M7.91675 5L12.9167 10L7.91675 15" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </button>
                            </div>
                          </div>
                        </div>
                        <span class="tab-list-item-date">{{ article.created_at | date: "%d.%m" }}</span>
                      </div>
                      <div class="tab-list-item-mobile-image">
                        <img
                          src="{{ article.image | img_url: 'master' }}"
                          alt="{{ article.title }}"
                          width="100%"
                          height="100%"
                        >
                      </div>
                    </div>
                  {% endfor %}
                {% endif %}
              {% elsif block.type == 'events_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% assign event_count = 0 %}
                  {% for article in selected_blog.articles %}
                    {% assign article_matches_city = false %}
                    {% assign event_date = '' %}
                    {% assign event_date_calendar = '' %}
                    
                    {% comment %} Extract event date {% endcomment %}
                    {% for tag in article.tags %}
                      {% if tag contains "event-date::" %}
                        {% assign event_date_raw = tag | remove: "event-date::" %}
                        {% assign event_date_parsed = event_date_raw | date: "%Y-%m-%d" %}
                        {% assign event_date = event_date_parsed | date: "%d.%m" %}
                        {% assign event_date_calendar = event_date_raw %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    
                    {% comment %} Check if article matches city {% endcomment %}
                    {% for tag in article.tags %}
                      {% assign normalized_tag = tag | downcase | remove: '#' %}
                      {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                      {% if normalized_tag == normalized_city_tag %}
                        {% assign article_matches_city = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    
                    {% if article_matches_city %}
                      {% assign event_count = event_count | plus: 1 %}
                      <div
                        class="tab-list-item-container {% if tab_group == first_tab_group %}active{% endif %} {% if event_count == 1 %}expanded{% endif %}"
                        data-tab-group-title="{{ tab_group }}"
                        data-tab-id="event-{{ block.id }}-{{ article.id }}"
                      >
                        <div class="tab-list-item-header">
                          <p class="tab-list-item-index">/{{ event_count | prepend: '0' | slice: -2, 2 }}</p>
                          <div class="tab-list-item-content-container">
                            <div class="tab-list-item-content">
                              <span class="tab-list-item-title font-zen">{{ article.title }}</span>
                              <div class="tab-list-item-content-inner">
                                <span class="tab-list-item-subtitle">{{ article.excerpt_or_content | strip_html | truncatewords: 15 }}</span>
                                <span class="tab-list-item-date-mobile-only">{{ event_date }}</span>
                                <button
                                  class="tab-list-item-button"
                                  onclick="addToCalendar('{{ article.title }}', '{{ event_date_calendar }}')"
                                >
                                  <span> Add to Calendar </span>
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                  >
                                    <path d="M7.91675 5L12.9167 10L7.91675 15" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </button>
                              </div>
                            </div>
                          </div>
                          <span class="tab-list-item-date">{{ event_date }}</span>
                        </div>
                        <div class="tab-list-item-mobile-image">
                          <img
                            src="{{ article.image | img_url: 'master' }}"
                            alt="{{ article.title }}"
                            width="100%"
                            height="100%"
                          >
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                  
                  {% comment %} Show "No events found" if no articles matched this city {% endcomment %}
                  {% if event_count == 0 %}
                    <div
                      class="tab-list-item-container no-events {% if tab_group == first_tab_group %}active{% endif %}"
                      data-tab-group-title="{{ tab_group }}"
                    >
                      <div class="tab-list-item-header">
                        <p class="tab-list-item-index">/00</p>
                        <div class="tab-list-item-content-container">
                          <div class="tab-list-item-content">
                            <span class="tab-list-item-title font-zen">No events found</span>
                            <div class="tab-list-item-content-inner">
                              <span class="tab-list-item-subtitle">There are currently no events scheduled for {{ block.settings.city_name }}.</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endif %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<script src="{{ 'component-latest-features.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store Features & Events",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title"
    },
    {
      "type": "text",
      "id": "main_title_width",
      "label": "Main Title Width",
      "default": "732"
    },
    {
      "type": "select",
      "id": "main_title_align",
      "label": "Main Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title"
    },
    {
      "type": "select",
      "id": "sub_title_align",
      "label": "Sub Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "arrow_text_1",
      "label": "Arrow Text Vertical"
    },
    {
      "type": "text",
      "id": "arrow_text_2",
      "label": "Arrow Text Horizontal"
    },
    {
      "type": "checkbox",
      "id": "show_tab_list",
      "label": "Show Tab List",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "blog_block",
      "name": "Blog Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_group_name",
          "label": "Tab Group Name",
          "info": "The name that will appear on the tab"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Select Blog",
          "info": "Choose the blog to display articles from"
        }
      ]
    },
    {
      "type": "events_block",
      "name": "Events Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_group_name",
          "label": "Tab Group Name",
          "info": "The name that will appear on the tab"
        },
        {
          "type": "text",
          "id": "city_name",
          "label": "City Name",
          "info": "The city to filter events for"
        },
        {
          "type": "text",
          "id": "city_tag",
          "label": "City Tag",
          "info": "The tag used in blog articles to identify events for this city (e.g., 'MIAMI', 'NEW-YORK')"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Select Blog",
          "info": "Choose the blog containing event articles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Features & Events",
      "category": "Custom"
    }
  ]
}
{% endschema %}
