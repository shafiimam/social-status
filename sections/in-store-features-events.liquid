{{ 'section-latest-features.css' | asset_url | stylesheet_tag }}

{% assign tabs_list = section.blocks | map: 'settings' | map: 'tab_group_name' | uniq %}
<div class="latest-features-section">
  <div class="header-row">
    <div class="title-column" style="max-width: {{ section.settings.main_title_width }}px;">
      <h1 class="main-title h1" style="text-align: {{ section.settings.main_title_align }}">
        {{ section.settings.main_title }}
      </h1>
      <h2 class="sub-title h1 heading" style="text-align: {{ section.settings.sub_title_align }}">
        {{ section.settings.sub_title }}
      </h2>
    </div>
    <div class="arrow-label">
      <span class="arrow-text-vertical font-zen" aria-hidden="true">{{ section.settings.arrow_text_1 }}</span>
      <span class="arrow-text-horizontal-1 font-zen" aria-hidden="true">{{ section.settings.arrow_text_2 }}</span>
      <span class="arrow-text-horizontal-2 font-zen" aria-hidden="true">{{ section.settings.arrow_text_2 }}</span>
    </div>
  </div>

  <div class="tab-groups-container">
    <div class="tab-images-column">
      {% assign image_index = 0 %}
      {% assign max_articles = section.settings.max_articles | default: 5 %}
      {% for tab_group in tabs_list %}
        {% assign tab_image_count = 0 %}
        {% comment %} Loop through all blocks and filter by tab group {% endcomment %}
        {% for block in section.blocks %}
          {% if block.settings.tab_group_name == tab_group %}
            {% if block.type == 'blog_block' %}
              {% assign selected_blog = blogs[block.settings.blog] %}
              {% if selected_blog %}
                {% for article in selected_blog.articles %}
                  {% if tab_image_count < max_articles %}
                    <div
                      class="tab-image-item {% if image_index == 0 %}active{% endif %}"
                      data-tab-id="blog-{{ block.id }}-{{ article.id }}"
                      data-tab-image-index="{{ image_index }}"
                      data-tab-group-title="{{ tab_group }}"
                    >
                      {% if article.image %}
                        <img
                          src="{{ article.image | image_url: width: 1920 }}"
                          alt="{{ article.title }}"
                          width="100%"
                          height="100%"
                        >
                      {% endif %}
                    </div>
                    {% assign image_index = image_index | plus: 1 %}
                    {% assign tab_image_count = tab_image_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% elsif section.settings.fallback_image %}
                <img
                  src="{{ section.settings.fallback_image | image_url: width: 1920 }}"
                  alt="{{ article.title }}"
                  width="100%"
                  height="100%"
                >
              {% endif %}
            {% elsif block.type == 'events_block' %}
              {% assign selected_blog = blogs[block.settings.blog] %}
              {% comment %} Determine if there is any event for the city and set has_event for the selected_blog {% endcomment %}
              {% assign has_event = false %}
              {% if selected_blog %}
                {% for article in selected_blog.articles %}
                  {% assign article_matches_city = false %}
                  {% assign event_date = '' %}
                  {% assign is_future_event = false %}
                  {% assign has_date_tag = false %}
                  {% for tag in article.tags %}
                    {% if tag contains 'event-date::' %}
                      {% assign has_date_tag = true %}
                      {% assign event_date_raw = tag | remove: 'event-date::' %}
                      {% assign event_date_parsed = event_date_raw | date: '%Y-%m-%d' %}
                      {% assign event_date = event_date_parsed %}
                      {% assign today = 'now' | date: '%Y-%m-%d' %}
                      {% if event_date >= today %}
                        {% assign is_future_event = true %}
                      {% endif %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% unless has_date_tag %}
                    {% assign is_future_event = true %}
                  {% endunless %}
                  {% for tag in article.tags %}
                    {% assign normalized_tag = tag | downcase | remove: '#' %}
                    {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                    {% if normalized_tag == normalized_city_tag %}
                      {% assign article_matches_city = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if article_matches_city and is_future_event %}
                    {% assign has_event = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% if selected_blog and has_event %}
                {% for article in selected_blog.articles %}
                  {% assign article_matches_city = false %}
                  {% assign event_date = '' %}
                  {% assign is_future_event = false %}

                  {% comment %} Extract event date and check if it's in the future {% endcomment %}
                  {% assign has_date_tag = false %}
                  {% for tag in article.tags %}
                    {% if tag contains 'event-date::' %}
                      {% assign has_date_tag = true %}
                      {% assign event_date_raw = tag | remove: 'event-date::' %}
                      {% assign event_date_parsed = event_date_raw | date: '%Y-%m-%d' %}
                      {% assign event_date = event_date_parsed %}
                      {% assign today = 'now' | date: '%Y-%m-%d' %}
                      {% if event_date >= today %}
                        {% assign is_future_event = true %}
                      {% endif %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% comment %} If no date tag found, treat as future event {% endcomment %}
                  {% unless has_date_tag %}
                    {% assign is_future_event = true %}
                  {% endunless %}

                  {% comment %} Check if article matches city {% endcomment %}
                  {% for tag in article.tags %}
                    {% assign normalized_tag = tag | downcase | remove: '#' %}
                    {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                    {% if normalized_tag == normalized_city_tag %}
                      {% assign article_matches_city = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if article_matches_city and is_future_event and tab_image_count < max_articles %}
                    <div
                      class="tab-image-item {% if image_index == 0 %}active{% endif %}"
                      data-tab-id="event-{{ block.id }}-{{ article.id }}"
                      data-tab-image-index="{{ image_index }}"
                      data-tab-group-title="{{ tab_group }}"
                    >
                      {% if article.image %}
                        <img
                          src="{{ article.image | image_url: width: 1920 }}"
                          alt="{{ article.title }}"
                          width="100%"
                          height="100%"
                        >
                      {% endif %}
                    </div>
                    {% assign image_index = image_index | plus: 1 %}
                    {% assign tab_image_count = tab_image_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% elsif section.settings.fallback_image %}
                <img
                  src="{{ section.settings.fallback_image | image_url: width: 1920 }}"
                  alt="{{ article.title }}"
                  width="100%"
                  height="100%"
                >
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    <div class="tab-list-navs" data-tabs-hidden="{{ section.settings.show_tab_list }}">
      {% if section.settings.show_tab_list %}
        <div class="tabs-panel">
          {% for tab in tabs_list %}
            <button class="tab-list-nav-item {% if forloop.first %}active{% endif %}" data-tab-group-title="{{ tab }}">
              <span class="tab-list-nav-item-title">{{ tab }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
      <ul class="tab-list-item-contents">
        {% for tab_group in tabs_list %}
          {% assign first_tab_group = tabs_list.first %}
          {% assign total_item_count = 0 %}
          {% assign has_content = false %}
          {% assign max_articles = section.settings.max_articles | default: 5 %}

          {% comment %} First pass: count total items and check if there's content {% endcomment %}
          {% for block in section.blocks %}
            {% if block.settings.tab_group_name == tab_group %}
              {% if block.type == 'blog_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% assign total_item_count = total_item_count | plus: selected_blog.articles.size %}
                  {% assign has_content = true %}
                {% endif %}
              {% elsif block.type == 'events_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% for article in selected_blog.articles %}
                    {% assign article_matches_city = false %}
                    {% assign is_future_event = false %}

                    {% comment %} Extract event date and check if it's in the future {% endcomment %}
                    {% assign has_date_tag = false %}
                    {% for tag in article.tags %}
                      {% if tag contains 'event-date::' %}
                        {% assign has_date_tag = true %}
                        {% assign event_date_raw = tag | remove: 'event-date::' %}
                        {% assign event_date_parsed = event_date_raw | date: '%Y-%m-%d' %}
                        {% assign today = 'now' | date: '%Y-%m-%d' %}
                        {% if event_date_parsed >= today %}
                          {% assign is_future_event = true %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% comment %} If no date tag found, treat as future event {% endcomment %}
                    {% unless has_date_tag %}
                      {% assign is_future_event = true %}
                    {% endunless %}

                    {% comment %} Check if article matches city {% endcomment %}
                    {% for tag in article.tags %}
                      {% assign normalized_tag = tag | downcase | remove: '#' %}
                      {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                      {% if normalized_tag == normalized_city_tag %}
                        {% assign article_matches_city = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    {% if article_matches_city and is_future_event %}
                      {% assign total_item_count = total_item_count | plus: 1 %}
                      {% assign has_content = true %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% comment %} Second pass: render content {% endcomment %}
          {% assign current_item_count = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.tab_group_name == tab_group %}
              {% if block.type == 'blog_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% for article in selected_blog.articles %}
                    {% if current_item_count < max_articles %}
                      {% assign current_item_count = current_item_count | plus: 1 %}
                      <div
                        class="tab-list-item-container {% if tab_group == first_tab_group %}active{% endif %} {% if current_item_count == 1 %}expanded{% endif %}"
                        data-tab-group-title="{{ tab_group }}"
                        data-tab-id="blog-{{ block.id }}-{{ article.id }}"
                      >
                        <div class="tab-list-item-header">
                          <p class="tab-list-item-index">/{{ current_item_count | prepend: '0' | slice: -2, 2 }}</p>
                          <div class="tab-list-item-content-container">
                            <div class="tab-list-item-content">
                              <span class="tab-list-item-title font-zen">{{ article.title }}</span>
                              <div class="tab-list-item-content-inner">
                                <span class="tab-list-item-subtitle">
                                  {{- article.excerpt_or_content | strip_html | truncatewords: 15 -}}
                                </span>
                                <span class="tab-list-item-date-mobile-only">
                                  {{- article.created_at | date: '%m.%d.%Y' -}}
                                </span>
                                <a
                                  href="{{ article.url }}"
                                  class="tab-list-item-button"
                                >
                                  <span> {{ section.settings.blog_cta_label | default: 'Read Article' }} </span>
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                  >
                                    <path d="M7.91675 5L12.9167 10L7.91675 15" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </a>
                              </div>
                            </div>
                          </div>
                          <span class="tab-list-item-date">{{ article.created_at | date: '%m.%d.%Y' }}</span>
                        </div>
                        <div class="tab-list-item-mobile-image">
                          {% if article.image %}
                            <img
                              src="{{ article.image | image_url: width: 1920 }}"
                              alt="{{ article.title }}"
                              width="100%"
                              height="100%"
                            >
                          {% elsif section.settings.fallback_image %}
                            <img
                              src="{{ section.settings.fallback_image | image_url: width: 1920 }}"
                              alt="{{ article.title }}"
                              width="100%"
                              height="100%"
                            >
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% elsif block.type == 'events_block' %}
                {% assign selected_blog = blogs[block.settings.blog] %}
                {% if selected_blog %}
                  {% for article in selected_blog.articles %}
                    {% assign article_matches_city = false %}
                    {% assign event_date = '' %}
                    {% assign is_future_event = false %}

                    {% comment %} Extract event date and check if it's in the future {% endcomment %}
                    {% assign has_date_tag = false %}
                    {% for tag in article.tags %}
                      {% if tag contains 'event-date::' %}
                        {% assign has_date_tag = true %}
                        {% assign event_date_raw = tag | remove: 'event-date::' %}
                        {% assign event_date_parsed = event_date_raw | date: '%Y-%m-%d' %}
                        {% assign event_date = event_date_parsed %}
                        {% assign today = 'now' | date: '%Y-%m-%d' %}
                        {% if event_date >= today %}
                          {% assign is_future_event = true %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% comment %} If no date tag found, treat as future event {% endcomment %}
                    {% unless has_date_tag %}
                      {% assign is_future_event = true %}
                    {% endunless %}

                    {% comment %} Check if article matches city {% endcomment %}
                    {% for tag in article.tags %}
                      {% assign normalized_tag = tag | downcase | remove: '#' %}
                      {% assign normalized_city_tag = block.settings.city_tag | downcase | remove: '#' %}
                      {% if normalized_tag == normalized_city_tag %}
                        {% assign article_matches_city = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if article_matches_city and is_future_event and current_item_count < max_articles %}
                      {% assign current_item_count = current_item_count | plus: 1 %}
                      <div
                        class="tab-list-item-container {% if tab_group == first_tab_group %}active{% endif %} {% if current_item_count == 1 %}expanded{% endif %}"
                        data-tab-group-title="{{ tab_group }}"
                        data-tab-id="event-{{ block.id }}-{{ article.id }}"
                        data-article-url="{{ article.url }}"
                      >
                        <div class="tab-list-item-header">
                          <p class="tab-list-item-index">/{{ current_item_count | prepend: '0' | slice: -2, 2 }}</p>
                          <div class="tab-list-item-content-container">
                            <div class="tab-list-item-content">
                              <span class="tab-list-item-title font-zen">{{ article.title }}</span>
                              <div class="tab-list-item-content-inner">
                                <span class="tab-list-item-subtitle">
                                  {{- article.excerpt_or_content | strip_html | truncatewords: 15 -}}
                                </span>
                                <span class="tab-list-item-date-mobile-only">{{ event_date | date: '%m.%d.%Y' }}</span>
                                <a
                                  class="tab-list-item-button"
                                  href="{{ article.url }}"
                                >
                                  <span> {{ section.settings.event_cta_label | default: 'Register Now' }} </span>
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                  >
                                    <path d="M7.91675 5L12.9167 10L7.91675 15" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </a>
                              </div>
                            </div>
                          </div>
                          <span class="tab-list-item-date">{{ event_date | date: '%m.%d.%Y' }}</span>
                        </div>
                        <div class="tab-list-item-mobile-image">
                          {% if article.image %}
                            <img
                              src="{{ article.image | image_url: width: 1920 }}"
                              alt="{{ article.title }}"
                              width="100%"
                              height="100%"
                            >
                          {% elsif section.settings.fallback_image %}
                            <img
                              src="{{ section.settings.fallback_image | image_url: width: 1920 }}"
                              alt="{{ article.title }}"
                              width="100%"
                              height="100%"
                            >
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% comment %} Add View More button if there are more items than the limit {% endcomment %}
          {% if total_item_count > max_articles %}
            <div
              class="tab-list-item-container view-more-container {% if tab_group == first_tab_group %}active{% endif %}"
              data-tab-group-title="{{ tab_group }}"
            >
              <div class="view-more-container">
                <div class="tab-cta-container">
                  {% assign view_more_url = selected_blog.url %}
                  {% if tab_group == 'Events' %}
                    {% assign view_more_url = pages['attend-an-event'].url %}
                  {% endif %}
                  <a href="{{ view_more_url }}" class="button button--solid button--with-icon">
                    <span class="view-more-text">{{ section.settings.view_more_label | default: 'View More' }}</span>
                    <span class="icon" aria-hidden="true">{%- render 'theme-symbols', icon: 'arrow-right' -%}</span>
                  </a>
                </div>
              </div>
            </div>
          {% endif %}

          {% comment %} Show "No content found" if no content in any blocks for this tab group {% endcomment %}
          {% unless has_content %}
            <div
              class="tab-list-item-container active expanded no-events {% if tab_group == first_tab_group %}active{% endif %}"
              data-tab-group-title="{{ tab_group }}"
            >
              <div class="tab-list-item-header">
                <p class="tab-list-item-index"></p>
                <div class="tab-list-item-content-container">
                  <div class="tab-list-item-content">
                    <span class="tab-list-item-title font-zen">{{ section.settings.no_event_title }}</span>
                    <div class="tab-list-item-content-inner">
                      <span class="tab-list-item-subtitle">{{ section.settings.no_event_info }}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<script src="{{ 'component-latest-features.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store Features & Events",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title"
    },
    {
      "type": "text",
      "id": "main_title_width",
      "label": "Main Title Width",
      "default": "732"
    },
    {
      "type": "select",
      "id": "main_title_align",
      "label": "Main Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title"
    },
    {
      "type": "select",
      "id": "sub_title_align",
      "label": "Sub Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "arrow_text_1",
      "label": "Arrow Text Vertical"
    },
    {
      "type": "text",
      "id": "arrow_text_2",
      "label": "Arrow Text Horizontal"
    },
    {
      "type": "checkbox",
      "id": "show_tab_list",
      "label": "Show Tab List",
      "default": true
    },
    {
      "type": "number",
      "id": "max_articles",
      "label": "Maximum Articles/Events",
      "default": 5,
      "info": "Maximum number of articles/events to show per tab group"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "View More Button Label",
      "default": "View More",
      "info": "Label text for the view more button"
    },
    {
      "type": "text",
      "id": "blog_cta_label",
      "label": "Blog CTA Label",
      "default": "Read Article",
      "info": "Label text for blog article buttons"
    },
    {
      "type": "text",
      "id": "event_cta_label",
      "label": "Event CTA Label",
      "default": "Register Now",
      "info": "Label text for event buttons"
    },
    {
      "type": "text",
      "id": "no_event_title",
      "label": "No Event Title",
      "default": "No Event found",
      "info": "Title text for no event found"
    },
    {
      "type": "text",
      "id": "no_event_info",
      "label": "No Event Info",
      "default": "There is currently no event available on this location.",
      "info": "Info text for no event found"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback Image",
      "info": "Image to display when an article or event has no featured image"
    }
  ],
  "blocks": [
    {
      "type": "blog_block",
      "name": "Blog Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_group_name",
          "label": "Tab Group Name",
          "info": "The name that will appear on the tab"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Select Blog",
          "info": "Choose the blog to display articles from"
        }
      ]
    },
    {
      "type": "events_block",
      "name": "Events Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_group_name",
          "label": "Tab Group Name",
          "info": "The name that will appear on the tab"
        },
        {
          "type": "text",
          "id": "city_name",
          "label": "City Name",
          "info": "The city to filter events for"
        },
        {
          "type": "text",
          "id": "city_tag",
          "label": "City Tag",
          "info": "The tag used in blog articles to identify events for this city (e.g., 'MIAMI', 'NEW-YORK')"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Select Blog",
          "info": "Choose the blog containing event articles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Features & Events",
      "category": "Custom"
    }
  ]
}
{% endschema %}
