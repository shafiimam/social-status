{% comment %} JotForm Assets for Book Event Form {% endcomment %}
<script src="https://form.jotform.com/static/feedback2.js" type="text/javascript" defer></script>
<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    var JFL_222295146958062 = new JotformFeedback({
        formId: '222295146958062',
        base: 'https://form.jotform.com/',
        windowTitle: 'Book Your Event at beSocial',
        background: '#FFA500',
        fontColor: '#FFFFFF',
        type: 'false',
        height: 500,
        width: 700,
        openOnLoad: false
    });
  });
</script>

{% style %}
  #shopify-section-{{ section.id }} {
     background-image: url({{ section.settings.background_image | image_url: width: 1920 }});
     background-size: cover;
     background-position: center;
     background-repeat: no-repeat;
     height: var(--window-height);
     
  }
{% endstyle %}

<div class="besocial-hero-section site-box-container container--fullscreen box--can-stick" id="shopify-section-{{ section.id }}">
  {% assign alpha_value = section.settings.overlay_opacity | divided_by: 100.00 %}
  <div 
    class="besocial-hero-overlay"
    style="background-color: rgba({{ section.settings.color_background.rgb | split:  ' ' |  join: ','  }}, {{ alpha_value }})"
  ></div>
  <div class="besocial-hero-container">
    <div class="besocial-hero-logo">
      <img
        src="{{ section.settings.logo | image_url: width: 500 }}"
        alt="{{ section.settings.logo.alt }}"
        width="470"
        height="100"
      > 
    </div>
    <div class="besocial-hero-blocks">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading_text' %}
            <div class="besocial-hero-heading-text" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h1 class="besocial-hero-heading h1">{{ block.settings.heading }}</h1>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="besocial-hero-content">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% when 'button' %}
            <div class="besocial-hero-button-wrapper">
              <a 
                {% if block.settings.book_form %}
                  class="button button--solid button--with-icon lightbox-222295146958062"
                {% else %}
                  href="{{ block.settings.button_link }}" 
                  class="button button--solid button--with-icon"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <span>{{ block.settings.button_text }}</span>
                <span class="icon" aria-hidden="true" role="img">
                  {%- render 'theme-symbols', icon: 'arrow-right' -%}
                </span>
              </a>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
{{ 'section-besocial-hero.css' | asset_url | stylesheet_tag }}
{% schema %}
{
  "name": "Be Social Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Overlay Color",
      "info": "Color overlay between text and background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Opacity of the background overlay"
    }
  ],
  "blocks": [
    {
      "type": "heading_text",
      "name": "Heading and Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "book_form",
          "label": "Book an Event Form",
          "default": false,
          "info": "When enabled, this button will open the Book Event form instead of navigating to the link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Be Social Hero",
      "category": "Custom",
      "blocks": [
        {
          "type": "heading_text",
          "settings": {
            "heading": "Welcome to beSocial",
            "text": "<p>Experience the ultimate social gaming destination</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_text": "About",
            "button_link": "#"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_text": "Book an Event",
            "button_link": "#"
          }
        }
      ]
    }
  ]
}
{% endschema %}
