{{ 'section-flagship-programs.css' | asset_url | stylesheet_tag }}

{% assign flagshipImage = section.settings.flagship_image | image_url: width: 5760 %}
{% assign alpha_value = section.settings.overlay_opacity | divided_by: 100.00 %}
<div id="flagship_programs" class="bgImg" style="background-image: url('{{ flagshipImage }}')">
  <div 
    class="flagship-programs-overlay"
    style="background-color: rgba({{ section.settings.color_background.rgb | split:  ' ' |  join: ','  }}, {{ alpha_value }})"
  ></div>
  <div class="container">
    <h2 class="title">{{ section.settings.flagship_title }}</h2>

    <div class="cols">
      {% for block in section.blocks %}
        {% if block.type == 'flagship' %}
          <div {{ block.shopify_attributes }} class="col">
            <article>
              <h2>{{ block.settings.title }}</h2>
              <div class="overlay">
                <div class="wrap">
                  <h2>{{ block.settings.title }}</h2>
                  {{ block.settings.text }}
                </div>
              </div>
            </article>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flagship Programs",
  "settings": [
    {
      "type": "image_picker",
      "id": "flagship_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "flagship_title",
      "label": "Section Title",
      "default": "FLAGSHIP PROGRAMS"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Overlay Color",
      "info": "Color overlay between content and background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Opacity of the background overlay"
    }
  ],
  "blocks": [
    {
      "name": "Flagship Program",
      "type": "flagship",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Program Title",
          "default": "<p>Free Game</p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Program Description",
          "default": "<p>A platform where we educate our community on topics that aren't regularly spoken or brought to the forefront.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flagship Programs",
      "category": "Custom"
    }
  ]
}
{% endschema %}
