{%- render 'custom-colors', id: section.id, background: section.settings.custom_background, text: section.settings.custom_text -%}

<div id="section-{{ section.id }}" class="site-box-container container--fullscreen box--can-stick"
  data-image-position="{{ section.settings.desktop_image_positioning }}"
>

  <div id="block-{{ section.id }}" 
    class="site-box box--big lap--box--small-fl-auto box__heading box--typo-big box--center-align box--top-align-if-first box--column-flow
     
    " data-order="0" 
    {% if section.settings.title == blank and section.settings.btn_label == blank and section.settings.bg_img == blank and section.settings.bg_video == blank %} style="display: none;" {% endif %}
    >

    <div class="site-box-content reduce-top-margin-if-first">
      <div class="content">
        <div>
                
          {%- unless section.settings.title == blank -%}
            {%- liquid
              # Homepage h1 comes from layout/theme.liquid (visually hidden), so any
              # heading set to h1 in the theme editor is demoted to h2 here. Keeps
              # exactly one <h1> on the homepage no matter what the editor says.
              assign h_tag = section.settings.seo_h_tag
              if template.name == 'index' and h_tag == 'h1'
                assign h_tag = 'h2'
              endif
            -%}
            <{{ h_tag }} class="title h1">{{ section.settings.title | escape }}</{{ h_tag }}>
          {%- endunless -%}

          {%- unless section.settings.btn_label == blank -%}
            <a class="button button--solid button--with-icon" {% unless section.settings.btn_url == blank %} href="{{ section.settings.btn_url | escape }}" {% endunless %} title="{{ section.settings.btn_label | escape }}">
              <span>{{ section.settings.btn_label | escape }}</span> 
              <span class="icon" aria-hidden="true" role="img">{%- render 'theme-symbols', icon: 'arrow_icon_smallest' -%}</span>
            </a>
          {%- endunless -%}

        </div>
      </div>
    </div>

    {%- unless section.settings.bg_img == blank and section.settings.bg_video == blank -%}  

      <span class="site-box-background {% if section.settings.bg_overlay %} with-image {% endif %}">

        {%- if section.settings.bg_img != blank -%}
          {%- liquid
            if section.index == 1
              assign preload = true
            else
              assign preload = false
            endif
          -%}

          {%- liquid
            render 'lazy-image', image: section.settings.bg_img, id: section.id, sizes: '(max-width: 1024px) and (orientation: portrait) max(100vw, 60vh), (max-width: 768px) max(100vw, 60vh), max(50vw, 100vh)', image_alignment: true, preload: preload
            if settings.show_preloader and section.settings.title == blank
              render 'preloader'
            endif
          -%}

        {%- elsif section.settings.bg_video != blank -%}
          <video 
            class="site-box-background-video"
            {% if section.settings.video_autoplay %}autoplay{% endif %}
            {% if section.settings.video_muted %}muted{% endif %}
            {% if section.settings.video_loop %}loop{% endif %}
            {% if section.settings.video_controls %}controls{% endif %}
            playsinline
            style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;"
          >
            {% for source in section.settings.bg_video.sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
            Your browser does not support the video tag.
          </video>

          {%- if settings.show_preloader and section.settings.title == blank -%}
            {%- render 'preloader' -%}
          {%- endif -%}

        {%- endif -%}

      </span> 

    {%- endunless -%}

  </div>

  {%- if section.blocks.size > 0 -%}

    <div class="site-box box--big lap--box--bigger box__text box--typo-big box--center-align box--column-flow" data-order="1" {% if section.settings.title == blank and section.settings.btn_label == blank and section.settings.bg_img == blank and section.settings.bg_video == blank %} style="width: 100% !important; height: auto !important; min-height: 0 !important;" {% endif %}>

        <div class="site-box-content">

        {%- for block in section.blocks -%}

          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- liquid
                # Homepage h1 comes from layout/theme.liquid (visually hidden), so any
                # heading set to h1 in the theme editor is demoted to h2 here. Keeps
                # exactly one <h1> on the homepage no matter what the editor says.
                assign h_tag = block.settings.seo_h_tag
                if template.name == 'index' and h_tag == 'h1'
                  assign h_tag = 'h2'
                endif
              -%}
              <{{ h_tag }} class="heading h3" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</{{ h_tag }}>

            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'button' -%}
              <a class="button button--solid button--with-icon" href="{{ block.settings.button_link | escape }}" title="{{ block.settings.button_label | escape }}" {{ block.shopify_attributes }}>
                <span>{{ block.settings.button_label | escape }}</span> 
                <span class="icon" aria-hidden="true" role="img">{%- render 'theme-symbols', icon: 'arrow_icon_smallest' -%}</span>
              </a>

          {%- endcase -%}

        {%- endfor -%}

      </div>

    </div>

  {%- endif -%}

</div>

{% schema %}
  {
    "name": "t:sections.rich-text.name",
    "class": "margins-quirk-if-first",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "t:sections.split-extra-words.settings_schema.headings.title",
        "default": "Call to action"
      },
      {
        "type": "text",
        "id": "btn_label",
        "label": "t:sections.rich-text.blocks.button.settings.button_label.label",
        "default": "More info"
      },
      {
        "type": "url",
        "id": "btn_url",
        "label": "t:sections.rich-text.blocks.button.settings.button_link.label"
      },
      {
        "type": "image_picker",
        "id": "bg_img",
        "label": "t:sections.image-with-text.blocks.image.settings.image.label"
      },
      {
        "type": "video",
        "id": "bg_video",
        "label": "Background Video",
        "info": "Video will be shown if no background image is set"
      },
      {
        "type": "checkbox",
        "id": "video_autoplay",
        "label": "Autoplay Video",
        "default": true,
        "info": "Video will play automatically when page loads"
      },
      {
        "type": "checkbox",
        "id": "video_muted",
        "label": "Mute Video",
        "default": true,
        "info": "Video will be muted by default (required for autoplay in most browsers)"
      },
      {
        "type": "checkbox",
        "id": "video_loop",
        "label": "Loop Video",
        "default": true,
        "info": "Video will repeat continuously"
      },
      {
        "type": "checkbox",
        "id": "video_controls",
        "label": "Show Video Controls",
        "default": false,
        "info": "Display play/pause and other video controls"
      },
      {
        "type": "select",
        "id": "desktop_image_positioning",
        "label": "t:sections.split-extra-words.sections.rich-text.image_position",
        "options": [
          {
            "value": "image-on-left",
            "label": "t:sections.split-extra-words.sections.split-screen-slider.settings.desktop_layout.options__1"
          },
          {
            "value": "image-on-right",
            "label": "t:sections.split-extra-words.sections.split-screen-slider.settings.desktop_layout.options__2"
          }
        ],
        "default": "image-on-left"
      },
      {
        "type": "checkbox",
        "id": "bg_overlay",
        "label": "t:sections.split-extra-words.sections.rich-text.overlay",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.split-extra-words.settings_schema.colors.headings.custom_colors"
      },
      {
        "type": "color",
        "id": "custom_background",
        "label": "t:sections.split-extra-words.settings_schema.colors.settings.background",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "custom_text",
        "label": "t:sections.split-extra-words.settings_schema.colors.settings.text",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "header",
        "content": "t:sections.refactor_words.seo.name"
      },
      {
        "type": "select",
        "id": "seo_h_tag",
        "label": "t:sections.refactor_words.seo.label",
        "info": "t:sections.refactor_words.seo.info",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          },
          {
            "value": "h3",
            "label": "H3"
          },
          {
            "value": "h4",
            "label": "H4"
          },
          {
            "value": "span",
            "label": "span"
          }
        ],
        "default": "h2"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "t:sections.rich-text.blocks.heading.name",
        "settings": [
           {
            "type": "text",
            "id": "heading",
            "label": "t:sections.rich-text.blocks.heading.settings.heading.label",
            "default": "Talk about your brand"
          },
          {
            "type": "header",
            "content": "t:sections.refactor_words.seo.name"
          },
          {
            "type": "select",
            "id": "seo_h_tag",
            "label": "t:sections.refactor_words.seo.label",
            "info": "t:sections.refactor_words.seo.info",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              },
              {
                "value": "span",
                "label": "span"
              }
            ],
            "default": "h3"
          }
        ]
      },
      { 
        "type": "text",
        "name": "t:sections.rich-text.blocks.text.name",
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "t:sections.rich-text.blocks.text.settings.text.label",
            "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
          }
        ]
      },
      {
        "type": "button",
        "name": "t:sections.rich-text.blocks.button.name",
        "settings": [
          {
            "type": "text",
            "id": "button_label",
            "label": "t:sections.rich-text.blocks.button.settings.button_label.label",
            "default": "Button label"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "t:sections.rich-text.blocks.button.settings.button_link.label"
          }
        ]
      }
    ],
    "presets": [{
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }],
		"disabled_on": {
			"groups": ["custom.overlay", "header"]
		}
  }
{% endschema %}