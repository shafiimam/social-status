<div
  class="customer-wishlist-section"
>
  <div class="container container--full">
    <h2 class="h2 text-left">{{ section.settings.title }}</h2>
    <div class="wishlist-product-container" data-customer-id="{{ customer.id }}">
      <div class="wishlist-root">
        {% comment %} will dynamically load the wishlist {% endcomment %}
      </div>
    </div>
  </div>
</div>
{% render 'flickity-assets' %}
<script src="{{ 'wishlist-script.js' | asset_url }}" defer></script>
<style>
  .wishlist-product-container {
    margin-top: 40px;
  }
  .customer-wishlist-section {
    padding-inline: var(--box-smaller-padding);
    max-width: 1600px;
    margin: 0 auto;
  }
  .wishlist-root:not(.flickity-enabled) {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  }
  .wishlist-root .product-card {
    max-width: 350px;
    margin-right: 42px;
    height: 500px;
  }
  .loading-spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    grid-column: span 4;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #3498db;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .remove-wishlist-item {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .remove-icon {
    font-size: 20px;
    color: #333;
  }

  .error-message {
    text-align: center;
    padding: 2rem;
    color: #e74c3c;
  }

  .empty-wishlist {
    text-align: center;
    padding: 2rem;
    color: #666;
  }
</style>
{% schema %}
{
  "name": "Wishlist",
  "class": "shopify-section--wishlist",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Wishlist"
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
