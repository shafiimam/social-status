{%- comment -%}
This snippet structures the micro-data using JSON-LD specification. For product and article pages, the data is 100% outputted by Shopify. The theme only offers schema for the organization and breadcrumb.
{%- endcomment -%}

{%- liquid
  # SEO DEV-05: richer Organization data (logo + official social profiles).
  # Logo: Shopify admin > Settings > Brand logo if set, else the header logo file.
  assign org_logo = shop.brand.logo
  if org_logo == blank
    assign org_logo = images['LOOP_LOGO_2.png']
  endif

  # sameAs: social URLs from Theme settings > Social media, query strings removed.
  assign same_as = ''
  assign social_urls = settings.social_facebook | append: '|' | append: settings.social_instagram | append: '|' | append: settings.social_twitter | append: '|' | append: settings.social_tiktok | append: '|' | append: settings.social_youtube | append: '|' | append: settings.social_pinterest | split: '|'
  for social_url in social_urls
    assign clean_url = social_url | split: '?' | first | strip
    if clean_url contains 'http'
      if same_as != ''
        assign same_as = same_as | append: ','
      endif
      assign same_as = same_as | append: clean_url
    endif
  endfor
  assign same_as = same_as | split: ','
-%}
<script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if org_logo != blank -%},
      "logo": {{ org_logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if same_as.size > 0 -%},
      "sameAs": {{ same_as | json }}
      {%- endif -%}
    }
  ]
</script>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumb.homepage' | t | json }},
      "item": "{{ shop.url }}"
    }
    {%- if request.page_type == 'product' -%}
      {%- assign product_position = '2' -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        }
        {%- assign product_position = '3' -%}
      {%- endif -%}
      ,{
        "@type": "ListItem",
        "position": {{ product_position }},
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
    {%- elsif request.page_type == 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    {%- elsif request.page_type == 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      }
    {%- elsif request.page_type == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      }, {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": "{{ shop.url }}{{ article.url }}"
      }
    {%- elsif request.page_type == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": "{{ shop.url }}{{ page.url }}"
      }
    {%- endif -%}
  ]
}
</script>

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">{{ product | structured_data }}</script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">{{ article | structured_data }}</script>
{%- endif -%}