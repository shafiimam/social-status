{% comment %}
  Renders a perspective slider specifically for blog events articles

  Accepts:
  - blog: object - Blog object containing articles
  - now_date: string - Current timestamp for filtering upcoming events
  - section_id: string - Unique section ID for styling
  - auto_play: boolean - Enable auto play (default: false)
  - background_color: string - Section background color
  - slide_overlay_color: string - Overlay color for slides
  - text_color: string - Section text color
  - text_color_card: string - Card text color
  - path_color: string - Control path color
  - text_alignment: string - Text alignment for cards
  - slider_height: number - Custom slider height in px (default: 350)
  - slide_width: number - Custom slide width in px (default: 400)
  - slide_height: number - Custom slide height in px (default: 250)
  - initial_index: number - Initial slide index (default: 3)
  - show_controls: boolean - Show gallery controls (default: true)
  - filter_city: string - City filter to apply to articles (optional)

  Usage:
  {% render 'blog-events-perspective-slider',
    blog: blog,
    now_date: now_date,
    section_id: 'blog-events-upcoming',
    auto_play: false,
    background_color: '#000000'
  %}
{% endcomment %}

{%- liquid
  assign show_controls = show_controls | default: true
  assign slider_height = slider_height | default: 350
  assign slide_width = slide_width | default: 400
  assign slide_height = slide_height | default: 250
  assign initial_index = initial_index | default: 3
  assign auto_play_enabled = auto_play | default: false
  assign text_alignment = text_alignment | default: 'center'
-%}

{% if auto_play_enabled %}
  <script>
    var perspectiveAutoPlay = 3000;
  </script>
{% else %}
  <script>
    var perspectiveAutoPlay = 0;
  </script>
{% endif %}

{%- comment -%} Count upcoming articles and create slider if any exist {%- endcomment -%}
{% assign upcoming_count = 0 %}
{% assign slide_counter = 0 %}
{% for article in blog.articles %}
  {% assign article_date = '' %}
  {% for tag in article.tags %}
    {% if tag contains "event-date::" %}
      {% assign article_date = tag | remove: "event-date::" | date: "%s" %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if article_date != '' and article_date > now_date %}
    {% assign article_matches_filter = false %}
    
    {% if filter_city.size == 0 %}
      {% assign article_matches_filter = true %}
    {% else %}
      {% assign filter_tag_upper = filter_city | upcase %}
      {% for tag in article.tags %}
        {% assign tag_upper = tag | upcase %}
        {% assign tag_without_hash = tag_upper | remove: '#' %}
        {% if tag_upper == filter_tag_upper or tag_without_hash == filter_tag_upper %}
          {% assign article_matches_filter = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
    
    {% if article_matches_filter %}
      {% assign upcoming_count = upcoming_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if upcoming_count > 0 %}
<div class="perspective-slider-section blog-events-perspective-slider" id="perspective-slider-{{ section_id }}">
  <div class="perspective-slider-container" data-slider-id="{{ section_id }}">
    {% assign slide_counter = 0 %}
    {% for article in blog.articles %}
      {% assign article_date = '' %}
      {% for tag in article.tags %}
        {% if tag contains "event-date::" %}
          {% assign article_date = tag | remove: "event-date::" | date: "%s" %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if article_date != '' and article_date > now_date %}
        {% assign article_matches_filter = false %}
        
        {% if filter_city.size == 0 %}
          {% assign article_matches_filter = true %}
        {% else %}
          {% assign filter_tag_upper = filter_city | upcase %}
          {% for tag in article.tags %}
            {% assign tag_upper = tag | upcase %}
              {% assign tag_without_hash = tag_upper | remove: '#' %}
            {% if tag_upper == filter_tag_upper or tag_without_hash == filter_tag_upper %}
              {% assign article_matches_filter = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        
        {% if article_matches_filter %}
          {%- liquid
            assign formatted_date = ''
            for tag in article.tags
              if tag contains "event-date::"
                assign formatted_date = tag | remove: "event-date::" | date: "%m,%d,%Y"
                break
              endif
            endfor
          -%}
      
      <div class="block-slide-item blog-event-slide">
        <div class="block-slide-image-container" style="--slide-overlay-color: {{ slide_overlay_color }}">
          {% if article.image %}
            <picture>
              <source srcset="{{ article.image | image_url: width: 300 }}" media="(max-width: 600px)">
              <img
                src="{{ article.image | image_url: width: 600 }}"
                alt="{{ article.image.alt | default: article.title }}"
                width="600"
                height="250"
                loading="lazy"
              >
            </picture>
          {% else %}
            <div class="placeholder-image" style="width: 600px; height: 250px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
              <span>No image</span>
            </div>
          {% endif %}
          
          <div class="block-slide-content">
            <div class="block-slide-content-inner" style="text-align: {{ text_alignment }}">
              {% if article.title != blank %}
                <p class="block-slide-title heading" style="color: {{ text_color_card }}">{{ article.title }}</p>
              {% endif %}
              
              <div class="block-slide-description" style="color: {{ text_color_card }}">
                {% if formatted_date != blank %}
                  <p class="event-date"><strong>{{ formatted_date }}</strong></p>
                {% endif %}
                {% if article.excerpt != blank %}
                  <p class="event-excerpt">{{ article.excerpt | strip_html | truncate: 80 }}</p>
                {% endif %}
              </div>
              
              <a href="{{ article.url }}" class="block-slide-button">More Info</a>
            </div>
          </div>
        </div>
      </div>
      
          {% assign slide_counter = slide_counter | plus: 1 %}
          {% if slide_counter >= 8 %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
  
  {% if show_controls and slide_counter > 0 %}
    <div class="gallery-controls">
      {% render '360-knob', total_frames: slide_counter, path_color: path_color %}
    </div>
  {% endif %}
</div>
{% else %}
  <div class="no-events-message">
    <p>No upcoming events to display in slider.</p>
  </div>
{% endif %}

<style>
  #perspective-slider-{{ section_id }} {
    {% if background_color %}background-color: {{ background_color }};{% endif %}
  }
  #perspective-slider-{{ section_id }} .heading {
    {% if text_color %}color: {{ text_color }};{% endif %}
  }
  #perspective-slider-{{ section_id }} .flickity-viewport {
    overflow: visible !important;
    height: {{ slider_height }}px !important;
  }
  #perspective-slider-{{ section_id }} .block-slide-item {
    width: {{ slide_width }}px;
    height: {{ slide_height }}px;
  }
  
  /* Blog event specific styles */
  #perspective-slider-{{ section_id }} .event-date {
    font-size: 14px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  #perspective-slider-{{ section_id }} .event-excerpt {
    font-size: 12px;
    line-height: 1.4;
    margin-bottom: 0;
  }
  
  @media only screen and (max-width: 768px) {
    #perspective-slider-{{ section_id }} .block-slide-item {
      height: {{ slide_height | minus: 50 }}px;
      width: {{ slide_width | minus: 50 }}px;
    }
  }
  
  @media only screen and (max-width: 480px) {
    #perspective-slider-{{ section_id }} .block-slide-item {
      height: {{ slide_height | minus: 50 }}px;
      width: {{ slide_width | minus: 100 }}px;
    }
  }
</style>

{{ 'section-perspective-slider.css' | asset_url | stylesheet_tag }}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderContainer = document.querySelector('[data-slider-id="{{ section_id }}"]');
    if (sliderContainer) {
      var perspectiveSlider = new Flickity(sliderContainer, {
        wrapAround: false,
        autoPlay: perspectiveAutoPlay,
        friction: 0.25,
        selectedAttraction: 0.01,
        initialIndex: {{ initial_index }},
        prevNextButtons: false,
        cellAlign: 'center',
        contain: false,
        pageDots: false,
        freeScroll: false,
        on: {
          ready: function () {
            const selectedSlide = sliderContainer.querySelector('.block-slide-item.is-selected');
            if (selectedSlide) {
              const previousSlide = selectedSlide.previousSibling;
              const nextSlide = selectedSlide.nextSibling;
              if (previousSlide) previousSlide.classList.add('is-previous');
              if (nextSlide) nextSlide.classList.add('is-next');
            }
          },
          change: function (index) {
            const slides = this.slides;
            let previousSlide = slides[index - 1]?.cells[0]?.element;
            let nextSlide = slides[index + 1]?.cells[0]?.element;
            if (!previousSlide) {
              previousSlide = slides[slides.length - 1]?.cells[0]?.element;
            }
            if (!nextSlide) {
              nextSlide = slides[0]?.cells[0]?.element;
            }
            for (let i = 0; i < slides.length; i++) {
              slides[i].cells[0].element.classList.remove('is-previous');
              slides[i].cells[0].element.classList.remove('is-next');
            }
            if (previousSlide) previousSlide.classList.add('is-previous');
            if (nextSlide) nextSlide.classList.add('is-next');
          },
        },
      });
      
      // Store reference globally with unique identifier
      window['perspectiveSlider_' + '{{ section_id }}'] = perspectiveSlider;
      // Also store as main reference for knob compatibility
      window.perspectiveSlider = perspectiveSlider;
      
      // Trigger knob initialization if available
      if (typeof window.initSliderKnob === 'function') {
        setTimeout(() => {
          window.initSliderKnob();
        }, 100);
      }
    }
  });
</script>
