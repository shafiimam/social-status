<div class="product-badges-holder">
	{%- liquid
		assign show_custom_badges = false
		assign has_exclude_tag = false
		
		if settings.custom_badge_enable and settings.custom_badge_text != blank
			# Split badge texts by comma
			assign badge_texts = settings.custom_badge_text | split: ','
			
			# Process include tags (comma-separated)
			assign include_tag_raw = settings.custom_badge_include_tag | strip
			assign exclude_tag_raw = settings.custom_badge_exclude_tag | strip
			
			# Normalize all product tags once
			assign normalized_product_tags = ""
			for product_tag in product.tags
				assign normalized_tag = product_tag | strip | downcase
				if normalized_product_tags == blank
					assign normalized_product_tags = normalized_tag
				else
					assign normalized_product_tags = normalized_product_tags | append: "|" | append: normalized_tag
				endif
			endfor
			
			if include_tag_raw != blank
				# Include tag logic: show badges for each matching include tag
				assign include_tags = include_tag_raw | split: ','
			else
				# Exclude tag logic: check if product should be excluded
				if exclude_tag_raw != blank
					assign exclude_tags = exclude_tag_raw | split: ','
					assign product_tags_array = normalized_product_tags | split: "|"
					
					for exclude_tag_item in exclude_tags
						assign normalized_exclude_tag = exclude_tag_item | strip | downcase
						for check_tag in product_tags_array
							if check_tag == normalized_exclude_tag
								assign has_exclude_tag = true
								break
							endif
						endfor
						if has_exclude_tag
							break
						endif
					endfor
				endif
			endif
		endif
	-%}

	{%- if settings.custom_badge_enable and settings.custom_badge_text != blank -%}
		{%- if include_tag_raw != blank -%}
			{%- comment -%} Include tag mode: show badge for each matching tag {%- endcomment -%}
			{%- for include_tag_item in include_tags -%}
				{%- liquid
					assign normalized_include_tag = include_tag_item | strip | downcase
					assign tag_index = forloop.index0
					assign product_tags_array = normalized_product_tags | split: "|"
					assign exact_match = false
					
					for check_tag in product_tags_array
						if check_tag == normalized_include_tag
							assign exact_match = true
							break
						endif
					endfor
				-%}
				{%- if exact_match and tag_index < badge_texts.size -%}
					{%- assign badge_text = badge_texts[tag_index] | strip -%}
					{%- if badge_text != blank -%}
						<div class="product-badge product-badge__custom-tag text-size--smaller"
							style="background-color: {{ settings.product_card_badge_regular_background_color }}; color: {{ settings.product_card_badge_regular_text_color }}; border-color: {{ settings.product_card_badge_regular_border_color }}"
						><span>{{ badge_text }}</span></div>
						{%- assign show_custom_badges = true -%}
					{%- endif -%}
				{%- endif -%}
			{%- endfor -%}
		{%- else -%}
			{%- comment -%} Exclude tag mode: show first badge if not excluded {%- endcomment -%}
			{%- if has_exclude_tag == false and badge_texts.size > 0 -%}
				{%- assign badge_text = badge_texts[0] | strip -%}
				{%- if badge_text != blank -%}
					<div class="product-badge product-badge__custom-tag text-size--smaller"
						style="background-color: {{ settings.product_card_badge_regular_background_color }}; color: {{ settings.product_card_badge_regular_text_color }}; border-color: {{ settings.product_card_badge_regular_border_color }}"
					><span>{{ badge_text }}</span></div>
					{%- assign show_custom_badges = true -%}
				{%- endif -%}
			{%- endif -%}
		{%- endif -%}
	{%- endif -%}

	{%- if show_custom_badges == false -%}
		{%- if product.available == false -%}
			<div class="product-badge product-badge__sold text-size--smaller"
				style="background-color: {{ settings.product_card_badge_sold_out_color }}; color: {{ settings.product_card_badge_sold_out_text_color }}"
			><span>{{ 'products.grid.sold_out_product' | t }}</span></div>
		{%- elsif product.compare_at_price > product.price and product.available -%}
			<span class="product-badge product-badge__sale text-size--smaller"
				style="background-color: {{ settings.product_card_badge_sale_color }}; color: {{ settings.product_card_badge_sale_text_color }}"
			> 

				{%- liquid 

					if product.compare_at_price_varies 
						assign compare_price_nums = 0
						assign max_compare_at_price = 0
						assign compare_at_price = 0
						assign price = 0
						for variant in product.variants
							if variant.compare_at_price > variant.price
								assign variant_compare_at_price = variant.compare_at_price | minus: variant.price
								if variant_compare_at_price > max_compare_at_price
									assign max_compare_at_price = variant_compare_at_price
									assign compare_at_price = variant.compare_at_price
									assign price = variant.price
									assign compare_price_nums = compare_price_nums | plus: 1
								endif
							endif
						endfor
					else
						assign compare_at_price = product.compare_at_price
						assign price = product.price
						assign compare_price_nums = 1
					endif

					if settings.product_card_badge_sale_type == 'percentage'
					assign saved = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round | prepend: '-' | append: '%'
						if compare_price_nums == 1 and product.compare_at_price_varies == false
							echo saved
						else 
							echo 'products.grid.save_percent' | t: percent: saved
						endif
					elsif settings.product_card_badge_sale_type == 'amount'
						assign saved = compare_at_price | minus: price | money
						if compare_price_nums == 1
							echo 'products.grid.save_amount_html' | t: amount: saved
						else
							echo 'products.grid.save_up_to_amount_html' | t: amount: saved
						endif
					else 
						echo 'products.grid.on_sale_product' | t
					endif
					
				-%}
			</span>
		{%- endif -%}
	{%- endif -%}

	{%- if product.tags contains 'preorder' or product.tags contains 'pre order' or product.tags contains 'Pre Order' %}
	  <div class="product-badge preorder text-size--smaller"
			style="background-color: {{ settings.product_card_badge_regular_background_color }}; color: {{ settings.product_card_badge_regular_text_color }}; border-color: {{ settings.product_card_badge_regular_border_color }}"
		><span>{{ 'products.grid.preorder_product' | t }}</span></div>
	{%- elsif product.tags contains 'new' -%}
	  <div class="product-badge new text-size--smaller"
			style="background-color: {{ settings.product_card_badge_regular_background_color }}; color: {{ settings.product_card_badge_regular_text_color }}; border-color: {{ settings.product_card_badge_regular_border_color }}"
		><span>{{ 'products.grid.new_product' | t }}</span></div>
	{%- endif -%}

	{%- if settings.product_card_custom_tag_badge_enabled -%}
		{%- assign include_tag = settings.product_card_custom_tag_badge_include_tag | downcase | strip -%}
		{%- assign exclude_tag = settings.product_card_custom_tag_badge_exclude_tag | downcase | strip -%}
		{%- assign show_custom_badge = false -%}
		
		{%- if include_tag != blank -%}
			{%- comment -%} If Include Tag is set, show badge ONLY for products with that tag {%- endcomment -%}
			{%- for tag in product.tags -%}
				{%- assign tag_downcase = tag | downcase | strip -%}
				{%- if tag_downcase == include_tag -%}
					{%- assign show_custom_badge = true -%}
					{%- break -%}
				{%- endif -%}
			{%- endfor -%}
		{%- else -%}
			{%- comment -%} If Include Tag is empty, use exclude tag logic (show by default, hide if exclude tag matches) {%- endcomment -%}
			{%- assign show_custom_badge = true -%}
			{%- if exclude_tag != blank -%}
				{%- for tag in product.tags -%}
					{%- assign tag_downcase = tag | downcase | strip -%}
					{%- if tag_downcase == exclude_tag -%}
						{%- assign show_custom_badge = false -%}
						{%- break -%}
					{%- endif -%}
				{%- endfor -%}
			{%- endif -%}
		{%- endif -%}
		
		{%- if show_custom_badge -%}
			<div class="product-badge product-badge__custom-tag text-size--smaller"
				style="background-color: {{ settings.product_card_custom_tag_badge_background_color }}; color: {{ settings.product_card_custom_tag_badge_text_color }}"
			><span>{{ settings.product_card_custom_tag_badge_text }}</span></div>
		{%- endif -%}
	{%- endif -%}

</div>