        "store_slide_ndW7FP": {
          "type": "store_slide",
          "settings": {
            "location_title": "SOCIAL STATUS BALTIMORE",
            "image": "shopify://shop_images/stockvault-baltimore-inner-harbor106254_3c43cbf2-28d9-41c3-a276-b112b63fe5d6.jpg",
            "location_info": "<p><a href=\"https://www.socialstatuspgh.com/\" target=\"_blank\">904 S Broadway, Baltimore MD 21231</a></p><h4>Operation Hours:</h4><p>Monday - Saturday: <strong>12:00PM- 7:00PM</strong></p><p>Sunday: <strong>12:00PM - 5:00PM</strong></p><h4>Contact:</h4><p><a href=\"tel:(410) 617-0916\">(410) 617-0916</a></p>",
            "location_content": "<p>Located in the Fells Point historic waterfront neighborhood, Social Status Baltimore is the most unique of our experiences across the network. Carved within a historic townhouse alongside the pier with a breathtaking view of the harbor, our 3-storey space features the modern contemporary aesthetic true to the Social Status brand while paying homage to the heritage of the city known for its imp[act on culture and history. Containing a modular beSocial space, community programming is ongoing within the footprint of the space and beyond to serve the city of Baltimore with impact and purpose.</p>",
            "button_label": "Visit Store Page",
            "store_link": ""
          }
