        "text_xjtLX8": {
          "type": "text",
          "settings": {
            "title": "Do you help promote community events on your channels?",
            "body": "<p>Yes. For approved events booked at least 6–8 weeks in advance, we provide an Eventbrite registration link, a flyer, and social media promotion across our channels. Events booked closer to the date may still run in the space but are not guaranteed promotional support.</p>"
