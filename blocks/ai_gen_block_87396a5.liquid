{% doc %}
  @prompt
    Create a text section with a CTA that links to a modal pop-up.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-cta-modal-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-cta-modal__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-text-cta-modal__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.2;
  }

  .ai-text-cta-modal__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    line-height: 1.6;
  }

  .ai-text-cta-modal__text-{{ ai_gen_id }} p {
    margin: 0 0 16px;
  }

  .ai-text-cta-modal__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-text-cta-modal__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
  }

  .ai-text-cta-modal__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-text-cta-modal__overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-text-cta-modal__overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-text-cta-modal__modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: {{ block.settings.modal_max_width }}px;
    max-height: 90vh;
    background-color: {{ block.settings.modal_background_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    padding: {{ block.settings.modal_padding }}px;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    overflow-y: auto;
  }

  .ai-text-cta-modal__modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-text-cta-modal__modal-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: {{ block.settings.modal_content_spacing }}px;
  }

  .ai-text-cta-modal__modal-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.modal_title_size }}px;
    color: {{ block.settings.modal_text_color }};
    margin: 0;
    line-height: 1.2;
    flex-grow: 1;
  }

  .ai-text-cta-modal__close-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin: -8px -8px 0 0;
    color: {{ block.settings.modal_text_color }};
    opacity: 0.7;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .ai-text-cta-modal__close-button-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-text-cta-modal__close-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .ai-text-cta-modal__modal-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.modal_content_size }}px;
    color: {{ block.settings.modal_text_color }};
    line-height: 1.6;
  }

  .ai-text-cta-modal__modal-content-{{ ai_gen_id }} p {
    margin: 0 0 16px;
  }

  .ai-text-cta-modal__modal-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-text-cta-modal__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-text-cta-modal__modal-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.modal_title_size }}px * 0.8);
    }

    .ai-text-cta-modal__modal-{{ ai_gen_id }} {
      padding: {{ block.settings.modal_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<text-cta-modal-{{ ai_gen_id }}
  class="ai-text-cta-modal-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-text-cta-modal__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-cta-modal__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-text-cta-modal__text-{{ ai_gen_id }}">
        {{ block.settings.text }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <button
        class="ai-text-cta-modal__button-{{ ai_gen_id }}"
        data-modal-trigger
        aria-label="{{ block.settings.button_text }}"
      >
        {{ block.settings.button_text }}
      </button>
    {% endif %}
  </div>

  <div
    class="ai-text-cta-modal__overlay-{{ ai_gen_id }}"
    data-modal-overlay
    aria-hidden="true"
  ></div>

  <div
    class="ai-text-cta-modal__modal-{{ ai_gen_id }}"
    data-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title-{{ ai_gen_id }}"
  >
    <div class="ai-text-cta-modal__modal-header-{{ ai_gen_id }}">
      {% if block.settings.modal_title != blank %}
        <h3
          class="ai-text-cta-modal__modal-title-{{ ai_gen_id }}"
          id="modal-title-{{ ai_gen_id }}"
        >
          {{ block.settings.modal_title }}
        </h3>
      {% endif %}
      <button
        class="ai-text-cta-modal__close-button-{{ ai_gen_id }}"
        data-modal-close
        aria-label="Close modal"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    {% if block.settings.modal_content != blank %}
      <div class="ai-text-cta-modal__modal-content-{{ ai_gen_id }}">
        {{ block.settings.modal_content }}
      </div>
    {% endif %}
  </div>
</text-cta-modal-{{ ai_gen_id }}>

<script>
  (function() {
    class TextCtaModal{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.trigger = this.querySelector('[data-modal-trigger]');
        this.modal = this.querySelector('[data-modal]');
        this.overlay = this.querySelector('[data-modal-overlay]');
        this.closeButton = this.querySelector('[data-modal-close]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.trigger) {
          this.trigger.addEventListener('click', () => this.openModal());
        }

        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => this.closeModal());
        }

        if (this.overlay) {
          this.overlay.addEventListener('click', () => this.closeModal());
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal() {
        this.modal.classList.add('active');
        this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.closeButton.focus();
      }

      closeModal() {
        this.modal.classList.remove('active');
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
        this.trigger.focus();
      }
    }

    customElements.define('text-cta-modal-{{ ai_gen_id }}', TextCtaModal{{ ai_gen_id }});
  })();
</script>

