{% doc %}
  @prompt
    Create a custom Shopify Online Store 2.0 hero/image section with the following features:
    
    **Images:**
    - Full-width image display, no distortion (object-fit: cover)
    - Separate desktop and mobile image uploads
    - Adjustable section height for desktop and mobile (px or vh)
    - Image position controls: horizontal (left, center, right) and vertical (top, center, bottom)
    
    **Overlay:**
    - Overlay color and opacity control (0–100%)
    
    **Text Content (all optional/hideable):**
    - Editable heading, subheading, and body copy
    - Font size controls for heading, subheading, and body — separate desktop and mobile sizes
    - Font color control for each text element
    - Text alignment: left, center, right
    - Option to hide all text and buttons (image-only mode)
    
    **Text Placement:**
    - 9-position grid placement: top-left, top-center, top-right, middle-left, middle-center, middle-right, bottom-left, bottom-center, bottom-right
    
    **Buttons:**
    - Option for 0, 1, or 2 buttons
    - Per button: label, link URL, background color, text color, border color, hover color
    
    **Layout:**
    - Content box max-width control
    - Padding controls for desktop and mobile (top, bottom, left, right)
    
    **Technical:**
    - Shopify OS 2.0 compatible (schema with settings and presets)
    - Responsive design
    - Clean, well-commented Liquid + CSS
    - Suitable for product collage images where text sits over open space without covering focal product areas (e.g., sneakers)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ block.settings.desktop_height }}{{ block.settings.desktop_height_unit }};
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_horizontal }} {{ block.settings.image_position_vertical }};
    display: block;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-hero-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    padding: {{ block.settings.desktop_padding_top }}px {{ block.settings.desktop_padding_right }}px {{ block.settings.desktop_padding_bottom }}px {{ block.settings.desktop_padding_left }}px;
    {% if block.settings.text_position == 'top-left' %}
      align-items: flex-start;
      justify-content: flex-start;
    {% elsif block.settings.text_position == 'top-center' %}
      align-items: flex-start;
      justify-content: center;
    {% elsif block.settings.text_position == 'top-right' %}
      align-items: flex-start;
      justify-content: flex-end;
    {% elsif block.settings.text_position == 'middle-left' %}
      align-items: center;
      justify-content: flex-start;
    {% elsif block.settings.text_position == 'middle-center' %}
      align-items: center;
      justify-content: center;
    {% elsif block.settings.text_position == 'middle-right' %}
      align-items: center;
      justify-content: flex-end;
    {% elsif block.settings.text_position == 'bottom-left' %}
      align-items: flex-end;
      justify-content: flex-start;
    {% elsif block.settings.text_position == 'bottom-center' %}
      align-items: flex-end;
      justify-content: center;
    {% elsif block.settings.text_position == 'bottom-right' %}
      align-items: flex-end;
      justify-content: flex-end;
    {% endif %}
  }

  .ai-hero-content-box-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_desktop }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ai-hero-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size_desktop }}px;
    color: {{ block.settings.body_color }};
    margin: 0 0 24px 0;
    line-height: 1.6;
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    {% if block.settings.text_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    text-decoration: none;
    border-radius: {{ settings.buttons_radius }}px;
    font-size: 16px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 2px solid;
  }

  .ai-hero-button-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_1_bg_color }};
    color: {{ block.settings.button_1_text_color }};
    border-color: {{ block.settings.button_1_border_color }};
  }

  .ai-hero-button-1-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_1_hover_color }};
  }

  .ai-hero-button-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_2_bg_color }};
    color: {{ block.settings.button_2_text_color }};
    border-color: {{ block.settings.button_2_border_color }};
  }

  .ai-hero-button-2-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}{{ block.settings.mobile_height_unit }};
    }

    .ai-hero-content-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_right }}px {{ block.settings.mobile_padding_bottom }}px {{ block.settings.mobile_padding_left }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-hero-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }

    .ai-hero-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-image-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-image-desktop-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_desktop %}
      <img
        src="{{ block.settings.image_desktop | image_url: width: 2400 }}"
        alt="{{ block.settings.image_desktop.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image_desktop.width }}"
        height="{{ block.settings.image_desktop.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-desktop-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }} ai-hero-image-desktop-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.image_mobile %}
      <img
        src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
        alt="{{ block.settings.image_mobile.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image_mobile.width }}"
        height="{{ block.settings.image_mobile.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}"
      >
    {% elsif block.settings.image_desktop %}
      <img
        src="{{ block.settings.image_desktop | image_url: width: 1200 }}"
        alt="{{ block.settings.image_desktop.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image_desktop.width }}"
        height="{{ block.settings.image_desktop.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>

  {% unless block.settings.hide_content %}
    <div class="ai-hero-content-wrapper-{{ ai_gen_id }}">
      <div class="ai-hero-content-box-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <div class="ai-hero-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
        {% endif %}

        {% if block.settings.button_count != 'none' %}
          <div class="ai-hero-buttons-{{ ai_gen_id }}">
            {% if block.settings.button_1_label != blank %}
              <a
                href="{{ block.settings.button_1_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-1-{{ ai_gen_id }}"
              >
                {{ block.settings.button_1_label }}
              </a>
            {% endif %}

            {% if block.settings.button_count == 'two' and block.settings.button_2_label != blank %}
              <a
                href="{{ block.settings.button_2_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-2-{{ ai_gen_id }}"
              >
                {{ block.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endunless %}
</div>

{% schema %}
