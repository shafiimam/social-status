{% doc %}
  @prompt
    can you generate a horizontal section that can feature an image for a product but also can have a direct shop now link to the product and feature a heading and description. The section does not need to be very tall, around the height of the "releases" section, the section can be slightly taller , can the section have the ability to alter the height of it and shrink , I do not need the section to stretch so wide. I dont want the image to expand to the full size and stretch the entire section. , this is way closer to how I want. can you make the section width be able to stretch across the entire screen (100%), are you able to make the section have a split image effect to where another image can be input on the right side of the section as well. Behind the text. I still want the exact same text options to exist as well 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-feature-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-split-feature-{{ ai_gen_id }}__images,
  .ai-split-feature-{{ ai_gen_id }}__image {
    position: absolute;
    inset: 0;
  }

  .ai-split-feature-{{ ai_gen_id }}__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .ai-split-feature-{{ ai_gen_id }}__image {
    position: relative;
    overflow: hidden;
  }

  .ai-split-feature-{{ ai_gen_id }}__image img,
  .ai-split-feature-{{ ai_gen_id }}__image-placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-feature-{{ ai_gen_id }}__image-placeholder {
    width: 100%;
    height: 100%;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-split-feature-{{ ai_gen_id }}__image-placeholder svg {
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-split-feature-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-split-feature-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    justify-content: center;
    width: min(100%, {{ block.settings.content_width }}px);
    min-height: {{ block.settings.section_height }}px;
    margin: 0 auto;
    padding: 32px 24px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-split-feature-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.headings_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-split-feature-{{ ai_gen_id }}__description {
    max-width: 560px;
    margin: 0 0 22px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.body_font.family }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  .ai-split-feature-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 24px;
    border-radius: {{ settings.buttons_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ settings.body_font.family }};
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .ai-split-feature-{{ ai_gen_id }}__button:hover,
  .ai-split-feature-{{ ai_gen_id }}__button:focus-visible {
    background: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-split-feature-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-split-feature-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_height }}px;
      padding: 28px 20px;
    }

    .ai-split-feature-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-split-feature-{{ ai_gen_id }}__images {
      grid-template-columns: 1fr;
    }

    .ai-split-feature-{{ ai_gen_id }}__image:nth-child(2) {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-split-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-feature-{{ ai_gen_id }}__images" aria-hidden="true">
    <div class="ai-split-feature-{{ ai_gen_id }}__image">
      {% if block.settings.left_image %}
        <img src="{{ block.settings.left_image | image_url: width: 1600 }}" alt="" loading="lazy" width="{{ block.settings.left_image.width }}" height="{{ block.settings.left_image.height }}">
      {% else %}
        <div class="ai-split-feature-{{ ai_gen_id }}__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    <div class="ai-split-feature-{{ ai_gen_id }}__image">
      {% if block.settings.right_image %}
        <img src="{{ block.settings.right_image | image_url: width: 1600 }}" alt="" loading="lazy" width="{{ block.settings.right_image.width }}" height="{{ block.settings.right_image.height }}">
      {% else %}
        <div class="ai-split-feature-{{ ai_gen_id }}__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
  </div>
  <div class="ai-split-feature-{{ ai_gen_id }}__overlay"></div>
  <div class="ai-split-feature-{{ ai_gen_id }}__content">
    {% if block.settings.heading != blank %}<h2 class="ai-split-feature-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-split-feature-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
    {% if block.settings.button_link != blank and block.settings.button_label != blank %}<a class="ai-split-feature-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Split feature banner",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"New release"},
    {"type":"textarea","id":"description","label":"Description","default":"Discover the latest piece from our collection."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop now"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"header","content":"Images"},
    {"type":"image_picker","id":"left_image","label":"Left image"},
    {"type":"image_picker","id":"right_image","label":"Right image"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"section_height","label":"Desktop height","min":180,"max":600,"step":10,"unit":"px","default":300},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":180,"max":500,"step":10,"unit":"px","default":280},
    {"type":"range","id":"content_width","label":"Content width","min":300,"max":1000,"step":50,"unit":"px","default":650},
    {"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"header","content":"Style"},
    {"type":"range","id":"heading_size","label":"Heading size","min":20,"max":64,"step":2,"unit":"px","default":40},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":44,"step":2,"unit":"px","default":30},
    {"type":"range","id":"description_size","label":"Description size","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"color","id":"text_color","label":"Text","default":"#ffffff"},
    {"type":"color","id":"overlay_color","label":"Overlay","default":"#000000"},
    {"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":5,"unit":"%","default":45},
    {"type":"color","id":"background_color","label":"Background","default":"#222222"},
    {"type":"color","id":"placeholder_color","label":"Placeholder background","default":"#dddddd"},
    {"type":"color","id":"placeholder_icon_color","label":"Placeholder icon","default":"#555555"},
    {"type":"color","id":"button_color","label":"Button","default":"#ffffff"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#000000"},
    {"type":"color","id":"button_hover_color","label":"Button hover","default":"#dddddd"}
  ],
  "presets": [{"name":"Split feature banner"}],
  "tag": null,
  "class": "split-feature-banner-block"
}
{% endschema %}