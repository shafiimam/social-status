{% doc %}
  @prompt
    can you add a break/space between these top two sections 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-spacer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: {{ block.settings.spacing_height }}px;
    background-color: {{ block.settings.background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-section-spacer-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_spacing_height }}px;
    }
  }
{% endstyle %}

<div
  class="ai-section-spacer-{{ ai_gen_id }}"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Section spacer",
  "settings": [
    {
      "type": "range",
      "id": "spacing_height",
      "label": "Desktop spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_spacing_height",
      "label": "Mobile spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Section spacer"
    }
  ],
  "tag": null,
  "class": "section-spacer-block"
}
{% endschema %}